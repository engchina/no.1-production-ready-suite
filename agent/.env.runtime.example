# agent/docker-compose.yml（第三者の Agent Runtime だけを起動する compose。#356）の ${...} 補間に使う値。
# `cp .env.runtime.example .env` で作る。Control Plane（backend）の設定は backend/.env と platform/.env に書く
# （backend は Docker を使わず `uv run` / systemd で動く。agent/README.md）。

# Runtime API 認証。Runtime 定義は値を保存せず env 名（auth_secret_ref）だけを参照する。
# Control Plane の backend にも同じ名前・同じ値を設定する。
# docker-compose.yml が各 Runtime の期待する名前（OPENCLAW_GATEWAY_TOKEN / API_SERVER_KEY /
# DEER_FLOW_INTERNAL_AUTH_TOKEN）へ渡す（#211 で AGENT_ 接頭辞に統一）。
AGENT_OPENCLAW_GATEWAY_TOKEN=
AGENT_HERMES_API_SERVER_KEY=
AGENT_DEER_FLOW_INTERNAL_AUTH_TOKEN=

# Control Plane が Binding の Skill / MCP を書き出す host のディレクトリ（backend の AGENT_RUNTIME_BINDINGS_DIR と同じ場所）。
# 各 Runtime へ /var/lib/control-plane/bindings として読み取り専用で渡す。
# AGENT_RUNTIME_BINDINGS_HOST_DIR=./backend/.agent-runtime-bindings

# host に公開する port（既定値）。
# OPENCLAW_PORT=18789
# HERMES_PORT=8642
# DEERFLOW_PORT=2026
