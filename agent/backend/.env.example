# Production Ready Agent — Agent 固有の設定（#211）
#
# このファイルを `agent/backend/.env` にコピーして使う。変数名はすべて `AGENT_` で始める。
# 3製品共通の設定（OCI 認証・アップロード保存先・モデル・データベース。`PLATFORM_*`）は
# monorepo の `platform/.env`（雛形は `platform/.env.example`）に置き、ここには書かない。
# backend は共通 `.env` → このファイルの順に読む（環境変数が最優先）。

# サービス共通の基本設定（pr_backend_core.BaseServiceSettings）
AGENT_APP_VERSION=0.1.0
AGENT_LOG_LEVEL=INFO
AGENT_ENVIRONMENT=local
AGENT_CORS_ORIGINS=["http://localhost:3000"]

# ===== 認証（#215 / #750。RAG / NL2SQL と同じ共通認証）=====
# local: ログインを省略し、全権限のローカル利用者として使う（開発用）。
# production: 共通認証のログインが必要。Cookie のないリクエストは 401。
# どちらもユーザー・ロールは Oracle の PLATFORM_* / AGENT_ROLE_*（共通 .env の PLATFORM_ORACLE_* が必要）。
# 構成管理者（PLATFORM_ADMIN_*）と認証ポリシー（PLATFORM_AUTH_*）は共通 .env（platform/.env）に置く。
# テーブルは 運用設定 > システムテーブル か `uv run python -m app.cli.agent_system_schema --initialize` で作る（PLATFORM_ORACLE_* で接続）。
AGENT_AUTH_MODE=local
# Cookie 名は製品ごと（同じホストで 3 製品を動かしてもセッションが混ざらない）。
AGENT_APP_AUTH_SESSION_COOKIE_NAME=agent_session
AGENT_APP_AUTH_CSRF_COOKIE_NAME=agent_csrf

# Runtime 状態の保存先（memory / file / oracle_checkpoint / oracle_normalized）
# AGENT_RUNTIME_REPOSITORY_BACKEND=memory
# AGENT_RUNTIME_ORACLE_DSN=
# AGENT_RUNTIME_ORACLE_USER=
# AGENT_RUNTIME_ORACLE_PASSWORD=

# ===== 外部 RAG / NL2SQL（各製品の MCP。#233）=====
# RAG / NL2SQL の `POST /api/mcp` を、Run を作った利用者（共通認証のユーザー）として呼ぶ。
# token は呼び出しごとに共通 .env の PLATFORM_SERVICE_TOKEN_SECRET で署名する（3製品で同じ値にする）。
# 画面の「外部 RAG」「外部 NL2SQL」からも変更できる（プロセス内の値。再起動でこのファイルの値に戻る）。
# AGENT_EXTERNAL_RAG_MCP_URL=http://rag-host/api/mcp
# AGENT_EXTERNAL_RAG_TIMEOUT_SECONDS=60
# AGENT_EXTERNAL_NL2SQL_MCP_URL=http://nl2sql-host/api/mcp
# AGENT_EXTERNAL_NL2SQL_TIMEOUT_SECONDS=60
# row_limit を省略したときに NL2SQL へ渡す取得件数（1〜1000 に丸める）。
# AGENT_EXTERNAL_NL2SQL_DEFAULT_LIMIT=100
# Run の利用者がいない呼び出し（Binding 経由の MCP）で使う
# 共通認証のログインユーザー ID。空ならその呼び出しは失敗する。RAG / NL2SQL の権限はこの利用者のもの。
# AGENT_MCP_SERVICE_USER_LOGIN_ID=

# Binding MCP token 派生用 master secret（32 bytes 以上）。
# Binding 個別の token は AGENT_BINDING_MCP_TOKEN_<BINDING_ID> でも指定できる。
# AGENT_CONTROL_PLANE_MCP_TOKEN_SECRET=

# Runtime API 認証（Runtime 定義の auth_secret_ref が参照する環境変数名）。
# backend は os.environ から読むため、ローカル実行では export する（本番は systemd の EnvironmentFile）。
# agent/docker-compose.yml で起動する第三者の Runtime にも、agent/.env で同じ値を渡す。
# AGENT_OPENCLAW_GATEWAY_TOKEN=
# AGENT_HERMES_API_SERVER_KEY=
# AGENT_DEER_FLOW_INTERNAL_AUTH_TOKEN=

# ===== Runtime との接続（第三者の Runtime は agent/docker-compose.yml。#356）=====
# Run の実行（in_process: backend の中 / external: 別プロセスの runtime-dispatcher。
# external のときは `uv run python -m app.features.agent.runtime_dispatcher` を別に起動する）。
# AGENT_RUNTIME_DISPATCH_MODE=in_process
# Binding の Skill / MCP の書き出し先。compose の Runtime には AGENT_RUNTIME_BINDINGS_HOST_DIR で同じ場所を渡す。
# AGENT_RUNTIME_BINDINGS_DIR=.agent-runtime-bindings
# Runtime から Binding MCP を呼ぶときの Control Plane の URL。compose の Runtime からは host.docker.internal で届く
# （開発の scripts/start-backend.sh は既定で 0.0.0.0:8020 で listen する）。
# AGENT_CONTROL_PLANE_PUBLIC_BASE_URL=http://host.docker.internal:8020/api
# 画面から compose の Runtime を起動・停止する（管理者の運用時だけ true。既定 false）。
# AGENT_RUNTIME_SERVICE_CONTROL_ENABLED=false
