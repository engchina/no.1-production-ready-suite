{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // 既定の correctness カテゴリ（oxlint 標準）に加え、src/** にデザインシステム遵守ルールを掛ける。
  // ルールと JS プラグインの正本は platform の docs/design-system/adherence.oxlintrc.json / design-system-plugin.mjs。
  // コピーせず相対パスで参照する（platform AGENTS.md「lint」節）。CI も platform を sibling に checkout している。
  // アプリ固有のルールを足す場合は、adherence のセレクタを上書きしないよう別のルール名にする。
  "extends": ["../../no.1-production-ready-platform/docs/design-system/adherence.oxlintrc.json"],
  // tests/** は computed style の実測値（rgb / px）や fixture を検証するため、adherence の対象外（files: src/**）。
  "ignorePatterns": ["dist/**", "playwright-report/**", "test-results/**"]
}
