#!/usr/bin/env bash
set -euo pipefail

echo "${PWD}|$*" >> "${NPM_CALL_LOG}"

case "$*" in
  ci)
    if [ "${FAIL_SHARED_INSTALL:-0}" = 1 ]; then exit 23; fi
    mkdir -p "${PWD}/node_modules"
    touch "${PWD}/node_modules/.package-lock.json"
    ;;
  install)
    mkdir -p "${PWD}/node_modules"
    touch "${PWD}/node_modules/.package-lock.json"
    ;;
  "run build")
    if [ "${FAIL_SHARED_BUILD:-0}" = 1 ]; then exit 24; fi
    mkdir -p "${SHARED_UI_DIR}/dist"
    : > "${SHARED_UI_DIR}/dist/index.js"
    : > "${SHARED_UI_DIR}/dist/index.d.ts"
    : > "${SHARED_UI_DIR}/dist/tokens.css"
    if [ -f "${PWD}/packages/system-settings/package.json" ]; then
      mkdir -p "${PWD}/packages/system-settings/dist"
      : > "${PWD}/packages/system-settings/dist/index.js"
      : > "${PWD}/packages/system-settings/dist/index.d.ts"
    fi
    ;;
  "run dev -- --host 0.0.0.0 --port 3997")
    ;;
  *)
    echo "unexpected npm invocation: $*" >&2
    exit 1
    ;;
esac
