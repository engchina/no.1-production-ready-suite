# No.1 Production Ready Suite — 3製品共通の設定（#211）
#
# このファイルを `platform/.env` にコピーして使う。RAG / NL2SQL / Agent の backend は
# 共通 `.env`（このファイル）→ 製品の `backend/.env` の順に読む（環境変数が最優先）。
# 場所は `PLATFORM_ENV_FILE` で上書きできる（コンテナなど）。
# システム設定画面（OCI 認証・アップロード保存先・モデル・データベース）で保存した値もここへ書かれる。
# 変数名はすべて `PLATFORM_` で始める。製品固有の設定は製品の `backend/.env` に置く。
# secret・OCID・DSN はここでは空にしておく。

# 構成管理者（共通認証。login ID は system_admin 固定）
PLATFORM_ADMIN_LOGIN_USER_ID=system_admin
PLATFORM_ADMIN_LOGIN_USER_PASSWORD=

# 認証ポリシー（共通認証。Cookie 名と認証の有効 / 無効は製品の backend/.env）
PLATFORM_AUTH_COOKIE_SECURE=false
PLATFORM_AUTH_IDLE_TIMEOUT_MINUTES=60
PLATFORM_AUTH_ABSOLUTE_TIMEOUT_HOURS=12
PLATFORM_AUTH_FAILED_LOGIN_LIMIT=5
PLATFORM_AUTH_LOCKOUT_MINUTES=15
PLATFORM_AUTH_PASSWORD_MIN_LENGTH=12
PLATFORM_AUTH_PASSWORD_MAX_LENGTH=128
PLATFORM_AUTH_ARGON2_TIME_COST=3
PLATFORM_AUTH_ARGON2_MEMORY_KIB=65536
PLATFORM_AUTH_ARGON2_PARALLELISM=4

# Oracle 26ai（3製品で同じ schema を使う）
PLATFORM_ORACLE_USER=
PLATFORM_ORACLE_PASSWORD=
PLATFORM_ORACLE_DSN=
# NL2SQL の DeepSec は python-oracledb Thin mode のみ対応。
PLATFORM_ORACLE_DRIVER_MODE=thin
PLATFORM_ORACLE_CONNECTION_SECURITY=wallet_mtls
# 空なら python-oracledb Thin mode（Wallet は PLATFORM_ORACLE_WALLET_DIR）。Instant Client を使う Thick mode は
# 配置先（例: /u01/aipoc/instantclient_23_26）を指定する。NL2SQL の DeepSec は Thin mode のみ対応。
PLATFORM_ORACLE_CLIENT_LIB_DIR=
PLATFORM_ORACLE_WALLET_DIR=/u01/aipoc/wallet
# 空欄の場合、OCI Wallet 自動取得では PLATFORM_ORACLE_PASSWORD を Wallet password として使用し、
# PLATFORM_ORACLE_WALLET_PASSWORD にも同じ値を保存する。
PLATFORM_ORACLE_WALLET_PASSWORD=
PLATFORM_ORACLE_DB_TEST_TIMEOUT_SECONDS=15
PLATFORM_ORACLE_TCP_CONNECT_TIMEOUT_SECONDS=10
PLATFORM_ORACLE_ADB_OCID=
PLATFORM_ORACLE_ADB_REGION=

# OCI 認証
PLATFORM_OCI_REGION=
PLATFORM_OCI_COMPARTMENT_ID=
PLATFORM_OCI_CONFIG_FILE=~/.oci/config
PLATFORM_OCI_CONFIG_PROFILE=DEFAULT
# NL2SQL の OCI 認証方式（config_file 以外を使う場合の API キー情報）
PLATFORM_OCI_AUTH_MODE=config_file
PLATFORM_OCI_USER_OCID=
PLATFORM_OCI_FINGERPRINT=
PLATFORM_OCI_TENANCY_OCID=
PLATFORM_OCI_KEY_FILE=

# モデル
# 秘密でない値は画面から PLATFORM_MODEL_SETTINGS_FILE（相対パスはこのファイルの場所から）へ保存する。
# API key は PLATFORM_OCI_ENTERPRISE_AI_API_KEY だけに置く。
PLATFORM_MODEL_SETTINGS_FILE=model-settings.json
PLATFORM_OCI_ENTERPRISE_AI_ENDPOINT=
PLATFORM_OCI_ENTERPRISE_AI_PROJECT_OCID=
PLATFORM_OCI_ENTERPRISE_AI_API_KEY=
PLATFORM_OCI_ENTERPRISE_AI_MODELS=[]
PLATFORM_OCI_ENTERPRISE_AI_DEFAULT_MODEL=
PLATFORM_OCI_ENTERPRISE_AI_LLM_MODEL=
PLATFORM_OCI_ENTERPRISE_AI_LLM_PATH=/responses
PLATFORM_OCI_ENTERPRISE_AI_LLM_PAYLOAD_TEMPLATE=
PLATFORM_OCI_ENTERPRISE_AI_LLM_RESPONSE_PATH=
PLATFORM_OCI_ENTERPRISE_AI_VLM_MODEL=
PLATFORM_OCI_ENTERPRISE_AI_VLM_PATH=/responses
PLATFORM_OCI_ENTERPRISE_AI_VLM_PAYLOAD_TEMPLATE=
PLATFORM_OCI_ENTERPRISE_AI_VLM_RESPONSE_PATH=
PLATFORM_OCI_ENTERPRISE_AI_VLM_INPUT_MODE=auto
PLATFORM_OCI_ENTERPRISE_AI_TIMEOUT_SECONDS=600
PLATFORM_OCI_ENTERPRISE_AI_MAX_RETRIES=3
PLATFORM_OCI_ENTERPRISE_AI_LLM_MAX_OUTPUT_TOKENS=1200
PLATFORM_OCI_ENTERPRISE_AI_VLM_MAX_OUTPUT_TOKENS=65536
# OCI Generative AI（埋め込み / リランクのみ）
PLATFORM_OCI_GENAI_EMBEDDING_MODEL=cohere.embed-v4.0
PLATFORM_OCI_GENAI_EMBEDDING_DIM=1536
PLATFORM_OCI_GENAI_RERANK_MODEL=cohere.rerank-v4.0-fast
# NL2SQL の埋め込み / リランク呼び出し先（空なら region から決める）
PLATFORM_OCI_GENAI_ENDPOINT=
PLATFORM_OCI_GENAI_EMBED_MODEL_ID=cohere.embed-v4.0
PLATFORM_OCI_GENAI_RERANK_MODEL_ID=cohere.rerank-v4.0-fast

# アップロード保存先
PLATFORM_UPLOAD_STORAGE_BACKEND=local
PLATFORM_LOCAL_STORAGE_DIR=/u01/data/production-ready
PLATFORM_OBJECT_STORAGE_REGION=
PLATFORM_OBJECT_STORAGE_NAMESPACE=
PLATFORM_OBJECT_STORAGE_BUCKET=
