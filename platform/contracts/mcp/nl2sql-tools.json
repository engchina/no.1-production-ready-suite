        ],
        "title": "Nl2SqlJobResult",
        "type": "object"
      }
    },
    {
      "name": "nl2sql_recommend_profile",
      "description": "質問に合う業務プロファイルを推薦します。推薦できないときは null です。profile_ids を渡すと、その中からだけ推薦します。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "利用者の質問（日本語）",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "profile_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "推薦の候補にする業務プロファイルの ID（省略時は使えるすべて）",
            "title": "Profile Ids"
          }
        },
        "required": [
          "question"
        ],
        "title": "RecommendProfileInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "RecommendationCandidate": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reason"
              },
              "score": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Score"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "title": "RecommendationCandidate",
            "type": "object"
          }
        },
        "properties": {
          "recommended_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommended Profile Id"
          },
          "rewritten_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rewritten Question"
          },
          "candidates": {
            "items": {
              "$ref": "#/$defs/RecommendationCandidate"
            },
            "title": "Candidates",
            "type": "array"
          }
        },
        "required": [
          "recommended_profile_id",
          "rewritten_question",
          "candidates"
        ],
        "title": "RecommendProfileOutput",
        "type": "object"
      }
    }
  ]
}
