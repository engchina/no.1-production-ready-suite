{
  "server": "production-ready-nl2sql",
  "tools": [
    {
      "name": "nl2sql_cancel_requirement",
      "description": "nl2sql_query の AI要件確認（needs_clarification）を取り消して閉じます（本人の確認だけ）。利用者がデータベースの検索は不要と伝えたときに使います。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "requirement_session_id": {
            "description": "閉じる AI要件確認の session（nl2sql_query の requirement.session_id）",
            "maxLength": 128,
            "minLength": 1,
            "title": "Requirement Session Id",
            "type": "string"
          }
        },
        "required": [
          "requirement_session_id"
        ],
        "title": "CancelRequirementInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false
      },
      "outputSchema": {
        "properties": {
          "requirement_session_id": {
            "title": "Requirement Session Id",
            "type": "string"
          },
          "status": {
            "description": "cancelled（閉じた）/ closed（もう閉じていた）",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "requirement_session_id",
          "status"
        ],
        "title": "CancelRequirementOutput",
        "type": "object"
      }
    },
    {
      "name": "nl2sql_get_job",
      "description": "nl2sql_query で作ったジョブの状態と結果を返します（本人のジョブだけ）。wait_seconds の間、完了を待ってから返します。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Job Id",
            "type": "string"
          },
          "wait_seconds": {
            "default": 0,
            "description": "完了を待つ秒数（0 はすぐ返す）。pending / running の間は 40 程度を渡し、終わるまでの呼び出しの回数を減らす",
            "maximum": 45,
            "minimum": 0,
            "title": "Wait Seconds",
            "type": "integer"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "GetJobInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "QueryStatus": {
            "description": "`nl2sql_query` / `nl2sql_get_job` の状態（ジョブの状態と、AI要件確認で止めた状態）。",
            "enum": [
              "pending",
              "running",
              "done",
              "error",
              "needs_clarification",
              "unanswerable"
            ],
            "title": "QueryStatus",
            "type": "string"
          },
          "RequirementCandidateOutput": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "description": {
                "default": "",
                "title": "Description",
                "type": "string"
              },
              "refs": {
                "default": "",
                "title": "Refs",
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "title": "RequirementCandidateOutput",
            "type": "object"
          },
          "RequirementOutput": {
            "description": "AI要件確認の状態（#1441。画面の AI要件確認と同じ session）。",
            "properties": {
              "session_id": {
                "title": "Session Id",
                "type": "string"
              },
              "status": {
                "description": "needs_answer / ready / unanswerable / applied / cancelled / skipped（OCI Enterprise AI が無い構成で確かめなかった）",
                "title": "Status",
                "type": "string"
              },
              "question": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RequirementQuestionOutput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "remaining_count": {
                "default": 0,
                "title": "Remaining Count",
                "type": "integer"
              },
              "answered_count": {
                "default": 0,
                "title": "Answered Count",
                "type": "integer"
              },
              "select_from_clear": {
                "default": false,
                "title": "Select From Clear",
                "type": "boolean"
              },
              "minimum_missing": {
                "items": {
                  "type": "string"
                },
                "title": "Minimum Missing",
                "type": "array"
              },
              "summary": {
                "default": "",
                "title": "Summary",
                "type": "string"
              },
              "clarified_question": {
                "default": "",
                "title": "Clarified Question",
                "type": "string"
              },
              "sql_skeleton": {
                "default": "",
                "title": "Sql Skeleton",
                "type": "string"
              },
              "message": {
                "default": "",
                "title": "Message",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "status"
            ],
            "title": "RequirementOutput",
            "type": "object"
          },
          "RequirementQuestionOutput": {
            "description": "利用者に確かめる 1 つの項目（表・列は物理名）。",
            "properties": {
              "item_id": {
                "title": "Item Id",
                "type": "string"
              },
              "section": {
                "description": "SQL のどの部分か（select / from / join / where / period / group_by / order_by / limit / subquery / other）",
                "title": "Section",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "question": {
                "title": "Question",
                "type": "string"
              },
              "reason": {
                "default": "",
                "title": "Reason",
                "type": "string"
              },
              "answer_kind": {
                "description": "single_select / multi_select / free_text",
                "title": "Answer Kind",
                "type": "string"
              },
              "candidates": {
                "items": {
                  "$ref": "#/$defs/RequirementCandidateOutput"
                },
                "title": "Candidates",
                "type": "array"
              },
              "value": {
                "default": "",
                "title": "Value",
                "type": "string"
              },
              "refs": {
                "default": "",
                "title": "Refs",
                "type": "string"
              }
            },
            "required": [
              "item_id",
              "section",
              "label",
              "question",
              "answer_kind"
            ],
            "title": "RequirementQuestionOutput",
            "type": "object"
          }
        },
        "description": "契約の `Nl2SqlJobResult`（Agent の `external_nl2sql_*` がそのまま通す）。",
        "properties": {
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/$defs/QueryStatus"
          },
          "profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Profile Id"
          },
          "generated_sql": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Generated Sql"
          },
          "executable_sql": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Executable Sql"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Explanation"
          },
          "is_safe": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Is Safe"
          },
          "safety_issues": {
            "items": {
              "type": "string"
            },
            "title": "Safety Issues",
            "type": "array"
          },
          "safety_check": {
            "anyOf": [
              {
                "enum": [
                  "checked",
                  "skipped"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "SQL の安全確認。checked（確かめた）/ skipped（Select AI・Select AI Agent が生成した SELECT 文のため省略。業務プロファイルの表・列の範囲の照合も行わない）",
            "title": "Safety Check"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "title": "Columns",
            "type": "array"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "returned_count": {
            "default": 0,
            "title": "Returned Count",
            "type": "integer"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total"
          },
          "has_more": {
            "default": false,
            "title": "Has More",
            "type": "boolean"
          },
          "truncated": {
            "default": false,
            "title": "Truncated",
            "type": "boolean"
          },
          "history_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "History Id"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "失敗の分類。status が error のときは必ず入る。Oracle のエラーなら ORA-xxxxx / DPY-xxxx、それ以外は SQL_BLOCKED（安全性の判定で止めた）・SQL_EXECUTION_FAILED・SCHEMA_CATALOG_EMPTY・JOB_CANCELLED・JOB_INTERRUPTED・NL2SQL_JOB_FAILED など",
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Message"
          },
          "requirement": {
            "anyOf": [
              {
                "$ref": "#/$defs/RequirementOutput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "status"
        ],
        "title": "Nl2SqlJobResult",
        "type": "object"
      }
    },
    {
      "name": "nl2sql_list_profiles",
      "description": "利用者が使える業務プロファイル（SQL を生成する対象の範囲）を一覧します。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "業務プロファイル名・説明の絞り込み語",
            "title": "Query"
          },
          "limit": {
            "default": 20,
            "description": "返す件数の上限",
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "ListProfilesInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "ProfileItem": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "category": {
                "title": "Category",
                "type": "string"
              },
              "description": {
                "title": "Description",
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "category",
              "description"
            ],
            "title": "ProfileItem",
            "type": "object"
          }
        },
        "properties": {
          "profiles": {
            "items": {
              "$ref": "#/$defs/ProfileItem"
            },
            "title": "Profiles",
            "type": "array"
          }
        },
        "required": [
          "profiles"
        ],
        "title": "ListProfilesOutput",
        "type": "object"
      }
    },
    {
      "name": "nl2sql_query",
      "description": "質問から SELECT SQL を生成して実行し、結果の行を返します。SQL の生成の方式は、業務プロファイルの既定の生成方式です。SQL を作る前に、足りない情報・明確でない情報を確かめます（AI要件確認）。確かめる項目があれば SQL を作らずに status=needs_clarification と requirement.question（質問・候補・理由。表・列は物理名）を 1 つだけ返すので、利用者に聞いてから requirement_session_id と answer を付けて呼び直します。wait_seconds 内に終わらなければ job_id を返すので、nl2sql_get_job で続きを取ります。",
      "inputSchema": {
        "$defs": {
          "RequirementAnswerInput": {
            "additionalProperties": false,
            "description": "AI要件確認の確認の項目への利用者の答え（#1441）。",
            "properties": {
              "item_id": {
                "description": "答える確認の項目の ID（前の結果の requirement.question.item_id）",
                "maxLength": 128,
                "minLength": 1,
                "title": "Item Id",
                "type": "string"
              },
              "selected_candidate_ids": {
                "description": "利用者が選んだ候補の ID（requirement.question.candidates の id）。候補に無い答えは free_text に入れる（selected_candidate_ids と free_text はどちらか一方）",
                "items": {
                  "type": "string"
                },
                "maxItems": 20,
                "title": "Selected Candidate Ids",
                "type": "array"
              },
              "free_text": {
                "default": "",
                "description": "候補に無い利用者の答え（利用者の言葉のまま）",
                "maxLength": 2000,
                "title": "Free Text",
                "type": "string"
              }
            },
            "required": [
              "item_id"
            ],
            "title": "RequirementAnswerInput",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "利用者の質問（日本語）",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "profile_id": {
            "description": "使う業務プロファイルの ID（必須）。分からないときは nl2sql_list_profiles / nl2sql_recommend_profile で選ぶ",
            "maxLength": 128,
            "minLength": 1,
            "title": "Profile Id",
            "type": "string"
          },
          "row_limit": {
            "default": 100,
            "description": "取得する行数の上限",
            "maximum": 1000,
            "minimum": 1,
            "title": "Row Limit",
            "type": "integer"
          },
          "wait_seconds": {
            "default": 40,
            "description": "結果を待つ秒数。過ぎたら pending / running のまま job_id を返す",
            "maximum": 45,
            "minimum": 0,
            "title": "Wait Seconds",
            "type": "integer"
          },
          "requirement_session_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "前の nl2sql_query が needs_clarification で返した requirement.session_id。確認の続き（answer を付ける）と SQL の生成に使う。省略すると新しく確かめ始める",
            "title": "Requirement Session Id"
          },
          "answer": {
            "anyOf": [
              {
                "$ref": "#/$defs/RequirementAnswerInput"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "requirement.question への利用者の答え（requirement_session_id と一緒に渡す）。利用者が答えていない問いを推測で埋めない"
          }
        },
        "required": [
          "question",
          "profile_id"
        ],
        "title": "QueryInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false
      },
      "outputSchema": {
        "$defs": {
          "QueryStatus": {
            "description": "`nl2sql_query` / `nl2sql_get_job` の状態（ジョブの状態と、AI要件確認で止めた状態）。",
            "enum": [
              "pending",
              "running",
              "done",
              "error",
              "needs_clarification",
              "unanswerable"
            ],
            "title": "QueryStatus",
            "type": "string"
          },
          "RequirementCandidateOutput": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "description": {
                "default": "",
                "title": "Description",
                "type": "string"
              },
              "refs": {
                "default": "",
                "title": "Refs",
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "title": "RequirementCandidateOutput",
            "type": "object"
          },
          "RequirementOutput": {
            "description": "AI要件確認の状態（#1441。画面の AI要件確認と同じ session）。",
            "properties": {
              "session_id": {
                "title": "Session Id",
                "type": "string"
              },
              "status": {
                "description": "needs_answer / ready / unanswerable / applied / cancelled / skipped（OCI Enterprise AI が無い構成で確かめなかった）",
                "title": "Status",
                "type": "string"
              },
              "question": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RequirementQuestionOutput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "remaining_count": {
                "default": 0,
                "title": "Remaining Count",
                "type": "integer"
              },
              "answered_count": {
                "default": 0,
                "title": "Answered Count",
                "type": "integer"
              },
              "select_from_clear": {
                "default": false,
                "title": "Select From Clear",
                "type": "boolean"
              },
              "minimum_missing": {
                "items": {
                  "type": "string"
                },
                "title": "Minimum Missing",
                "type": "array"
              },
              "summary": {
                "default": "",
                "title": "Summary",
                "type": "string"
              },
              "clarified_question": {
                "default": "",
                "title": "Clarified Question",
                "type": "string"
              },
              "sql_skeleton": {
                "default": "",
                "title": "Sql Skeleton",
                "type": "string"
              },
              "message": {
                "default": "",
                "title": "Message",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "status"
            ],
            "title": "RequirementOutput",
            "type": "object"
          },
          "RequirementQuestionOutput": {
            "description": "利用者に確かめる 1 つの項目（表・列は物理名）。",
            "properties": {
              "item_id": {
                "title": "Item Id",
                "type": "string"
              },
              "section": {
                "description": "SQL のどの部分か（select / from / join / where / period / group_by / order_by / limit / subquery / other）",
                "title": "Section",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "question": {
                "title": "Question",
                "type": "string"
              },
              "reason": {
                "default": "",
                "title": "Reason",
                "type": "string"
              },
              "answer_kind": {
                "description": "single_select / multi_select / free_text",
                "title": "Answer Kind",
                "type": "string"
              },
              "candidates": {
                "items": {
                  "$ref": "#/$defs/RequirementCandidateOutput"
                },
                "title": "Candidates",
                "type": "array"
              },
              "value": {
                "default": "",
                "title": "Value",
                "type": "string"
              },
              "refs": {
                "default": "",
                "title": "Refs",
                "type": "string"
              }
            },
            "required": [
              "item_id",
              "section",
              "label",
              "question",
              "answer_kind"
            ],
            "title": "RequirementQuestionOutput",
            "type": "object"
          }
        },
        "description": "契約の `Nl2SqlJobResult`（Agent の `external_nl2sql_*` がそのまま通す）。",
        "properties": {
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/$defs/QueryStatus"
          },
          "profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Profile Id"
          },
          "generated_sql": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Generated Sql"
          },
          "executable_sql": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Executable Sql"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Explanation"
          },
          "is_safe": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Is Safe"
          },
          "safety_issues": {
            "items": {
              "type": "string"
            },
            "title": "Safety Issues",
            "type": "array"
          },
          "safety_check": {
            "anyOf": [
              {
                "enum": [
                  "checked",
                  "skipped"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
