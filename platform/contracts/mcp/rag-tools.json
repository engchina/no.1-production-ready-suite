                "title": "Value"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "user=利用者が答えた / question=質問の文から読んだ。",
                "title": "Source"
              },
              "handling": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "不明のときの扱い（ask=確かめる / branch=分岐 / handoff=人へ）。",
                "title": "Handling"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "title": "GuideCondition",
            "type": "object"
          },
          "GuideRef": {
            "properties": {
              "guide_id": {
                "title": "Guide Id",
                "type": "string"
              },
              "revision": {
                "description": "使った公開の版。",
                "title": "Revision",
                "type": "integer"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "decision": {
                "description": "answer=条件がそろった / branch=分岐で答えた / clarify=確かめる / handoff=人へ。",
                "enum": [
                  "answer",
                  "branch",
                  "clarify",
                  "handoff"
                ],
                "title": "Decision",
                "type": "string"
              },
              "known_conditions": {
                "items": {
                  "$ref": "#/$defs/GuideCondition"
                },
                "title": "Known Conditions",
                "type": "array"
              },
              "unknown_conditions": {
                "items": {
                  "$ref": "#/$defs/GuideCondition"
                },
                "title": "Unknown Conditions",
                "type": "array"
              }
            },
            "required": [
              "guide_id",
              "revision",
              "title",
              "decision"
            ],
            "title": "GuideRef",
            "type": "object"
          },
          "RagEvidence": {
            "description": "検索・回答の根拠 1 件。",
            "properties": {
              "evidence_id": {
                "description": "根拠の id（chunk_id と同じ）。",
                "title": "Evidence Id",
                "type": "string"
              },
              "document_id": {
                "title": "Document Id",
                "type": "string"
              },
              "chunk_id": {
                "title": "Chunk Id",
                "type": "string"
              },
              "file_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "File Name"
              },
              "chunk_set_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "根拠を作った処理の版。",
                "title": "Chunk Set Id"
              },
              "recipe_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "根拠を作った処理レシピ。",
                "title": "Recipe Id"
              },
              "content_kind": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "内容の種類（text / table など）。",
                "title": "Content Kind"
              },
              "locator": {
                "$ref": "#/$defs/EvidenceLocator"
              },
              "excerpt": {
                "description": "本文の先頭（最大 1000 文字）。",
                "title": "Excerpt",
                "type": "string"
              },
              "truncated": {
                "description": "excerpt が本文の一部だけか。",
                "title": "Truncated",
                "type": "boolean"
              },
              "text_length": {
                "description": "本文の文字数。",
                "title": "Text Length",
                "type": "integer"
              },
              "used_in_answer": {
                "description": "回答の生成に使った根拠か。",
                "title": "Used In Answer",
                "type": "boolean"
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "根拠の役割（retrieved_anchor / parent_context など）。",
                "title": "Role"
              },
              "score": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Score"
              },
              "rerank_score": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Rerank Score"
              }
            },
            "required": [
              "evidence_id",
              "document_id",
              "chunk_id",
              "locator",
              "excerpt",
              "truncated",
              "text_length",
              "used_in_answer"
            ],
            "title": "RagEvidence",
            "type": "object"
          }
        },
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "guardrail_warnings": {
            "items": {
              "type": "string"
            },
            "title": "Guardrail Warnings",
            "type": "array"
          },
          "outcome": {
            "description": "回答の対応。answered=資料で答えた / conditional=条件・不足を示して答えた / needs_environment_data=現場の値・記録の確認が要る / insufficient_evidence=資料から答えられない。needs_clarification / needs_human は利用者への確認・人への引き継ぎ。",
            "enum": [
              "answered",
              "conditional",
              "needs_clarification",
              "needs_environment_data",
              "needs_human",
              "insufficient_evidence"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "requests": {
            "description": "質問の要求単位ごとの充足（背景の文は含めない）。",
            "items": {
              "$ref": "#/$defs/AnswerRequest"
            },
            "title": "Requests",
            "type": "array"
          },
          "conditions": {
            "description": "回答の説明が成り立つ条件（原文の語句。質問から確かめられないもの）。",
            "items": {
              "type": "string"
            },
            "title": "Conditions",
            "type": "array"
          },
          "gaps": {
            "description": "資料から確かめられない点。",
            "items": {
              "type": "string"
            },
            "title": "Gaps",
            "type": "array"
          },
          "confirmations": {
            "description": "回答を確定するために確かめる現場のデータ・別の資料。",
            "items": {
              "type": "string"
            },
            "title": "Confirmations",
            "type": "array"
          },
          "clarifications": {
            "description": "outcome=needs_clarification のとき、利用者に確かめる条件と問い（業務ガイド）。",
            "items": {
              "$ref": "#/$defs/GuideClarification"
            },
            "title": "Clarifications",
            "type": "array"
          },
          "guide": {
            "anyOf": [
              {
                "$ref": "#/$defs/GuideRef"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "回答に使った業務ガイド（公開の版）。使わなければ null。"
          },
          "insufficient_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "根拠が足りず答えきれなかった理由（無ければ null）。",
            "title": "Insufficient Reason"
          },
          "needs_human_review": {
            "default": false,
            "description": "人の確認が要る回答か。",
            "title": "Needs Human Review",
            "type": "boolean"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/RagEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "evidence_omitted": {
            "description": "evidence_limit を超えて返さなかった根拠の数。",
            "title": "Evidence Omitted",
            "type": "integer"
          }
        },
        "required": [
          "answer",
          "trace_id",
          "guardrail_warnings",
          "outcome",
          "evidence",
          "evidence_omitted"
        ],
        "title": "SearchOutput",
        "type": "object"
      }
    }
  ]
}
