              },
              "page_start": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "開始の頁（PDF の物理頁）。",
                "title": "Page Start"
              },
              "page_end": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "終了の頁（PDF の物理頁）。",
                "title": "Page End"
              },
              "sheet_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "表計算のシート名（#1221）。",
                "title": "Sheet Name"
              },
              "row_start": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "シートの開始の行（1 始まり）。",
                "title": "Row Start"
              },
              "row_end": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "シートの終了の行。",
                "title": "Row End"
