{
  "server": "production-ready-rag",
  "tools": [
    {
      "name": "rag_list_business_views",
      "description": "利用できる業務ビュー（ACTIVE）の一覧を返します。",
      "inputSchema": {
        "description": "業務ビュー一覧の条件。",
        "properties": {
          "query": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "名前・説明の部分一致（省略時は全件）。",
            "title": "Query"
          },
          "limit": {
            "default": 50,
            "description": "返す最大件数。",
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "ListBusinessViewsInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "BusinessViewItem": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Description"
              },
              "status": {
                "title": "Status",
                "type": "string"
              },
              "knowledge_base_count": {
                "title": "Knowledge Base Count",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "status",
              "knowledge_base_count"
            ],
            "title": "BusinessViewItem",
            "type": "object"
          }
        },
        "properties": {
          "business_views": {
            "items": {
              "$ref": "#/$defs/BusinessViewItem"
            },
            "title": "Business Views",
            "type": "array"
          }
        },
        "required": [
          "business_views"
        ],
        "title": "ListBusinessViewsOutput",
        "type": "object"
      }
    },
    {
      "name": "rag_search",
      "description": "業務ビューのナレッジベースを検索し、根拠（citations）付きの回答を返します。",
      "inputSchema": {
        "description": "検索・回答の条件。",
        "properties": {
          "query": {
            "description": "質問文。",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "business_view_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "業務ビューの id。参照するナレッジベースと検索・回答設定を使う。",
            "title": "Business View Id"
          },
          "knowledge_base_ids": {
            "description": "検索するナレッジベースの id（省略時は業務ビューの参照先）。",
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "title": "Knowledge Base Ids",
            "type": "array"
          },
          "top_k": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "検索する件数。",
            "title": "Top K"
          },
          "filters": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "検索フィルター（例: category_name）。",
            "title": "Filters",
            "type": "object"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "RagCitation": {
            "properties": {
              "document_id": {
                "title": "Document Id",
                "type": "string"
              },
              "chunk_id": {
                "title": "Chunk Id",
                "type": "string"
              },
              "file_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "File Name"
              },
              "text": {
                "description": "根拠の本文（先頭 1000 文字）。",
                "title": "Text",
                "type": "string"
              },
              "score": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Score"
              }
            },
            "required": [
              "document_id",
              "chunk_id",
              "text"
            ],
            "title": "RagCitation",
            "type": "object"
          }
        },
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "guardrail_warnings": {
            "items": {
              "type": "string"
            },
            "title": "Guardrail Warnings",
            "type": "array"
          },
          "citations": {
            "items": {
              "$ref": "#/$defs/RagCitation"
            },
            "title": "Citations",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "trace_id",
          "guardrail_warnings",
          "citations"
        ],
        "title": "SearchOutput",
        "type": "object"
      }
    }
  ]
}
