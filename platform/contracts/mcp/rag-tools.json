{
  "server": "production-ready-rag",
  "tools": [
    {
      "name": "rag_list_search_answer_profiles",
      "description": "利用できる検索・回答プロファイル（ACTIVE）の一覧を返します。",
      "inputSchema": {
        "description": "検索・回答プロファイル一覧の条件。",
        "properties": {
          "query": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "名前・説明の部分一致（省略時は全件）。",
            "title": "Query"
          },
          "limit": {
            "default": 50,
            "description": "返す最大件数。",
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "ListSearchAnswerProfilesInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "SearchAnswerProfileItem": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Description"
              },
              "status": {
                "title": "Status",
                "type": "string"
              },
              "knowledge_base_count": {
                "title": "Knowledge Base Count",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "status",
              "knowledge_base_count"
            ],
            "title": "SearchAnswerProfileItem",
            "type": "object"
          }
        },
        "properties": {
          "search_answer_profiles": {
            "items": {
              "$ref": "#/$defs/SearchAnswerProfileItem"
            },
            "title": "Search Answer Profiles",
            "type": "array"
          }
        },
        "required": [
          "search_answer_profiles"
        ],
        "title": "ListSearchAnswerProfilesOutput",
        "type": "object"
      }
    },
    {
      "name": "rag_lookup_guides",
      "description": "質問に当たる公開の業務ガイド（目的・確かめる条件と状態・手順の順・影響範囲・引き継ぎ先）を返します。回答は作りません。",
      "inputSchema": {
        "additionalProperties": false,
        "description": "質問に当たる業務ガイドを引く条件。",
        "properties": {
          "query": {
            "description": "質問文（利用者の目的）。",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "search_answer_profile_id": {
            "description": "検索・回答プロファイルの id。",
            "maxLength": 128,
            "minLength": 1,
            "title": "Search Answer Profile Id",
            "type": "string"
          },
          "conditions": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "分かっている条件の値（条件の id → 値）。",
            "maxProperties": 30,
            "title": "Conditions",
            "type": "object"
          },
          "limit": {
            "default": 3,
            "description": "返す業務ガイドの最大件数。",
            "maximum": 10,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query",
          "search_answer_profile_id"
        ],
        "title": "LookupGuidesInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "GuideClarification": {
            "properties": {
              "condition_id": {
                "description": "条件の id（conditions に値を入れて呼び直す）。",
                "title": "Condition Id",
                "type": "string"
              },
              "label": {
                "description": "条件の名前。",
                "title": "Label",
                "type": "string"
              },
              "question": {
                "description": "利用者に確かめる問い。",
                "title": "Question",
                "type": "string"
              },
              "options": {
                "description": "選択肢（無ければ自由に答える）。",
                "items": {
                  "type": "string"
                },
                "title": "Options",
                "type": "array"
              }
            },
            "required": [
              "condition_id",
              "label",
              "question"
            ],
            "title": "GuideClarification",
            "type": "object"
          },
          "GuideCondition": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Value"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "user=利用者が答えた / question=質問の文から読んだ。",
                "title": "Source"
              },
              "handling": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "不明のときの扱い（ask=確かめる / branch=分岐 / handoff=人へ）。",
                "title": "Handling"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "title": "GuideCondition",
            "type": "object"
          },
          "GuideStepItem": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "depends_on": {
                "items": {
                  "type": "string"
                },
                "title": "Depends On",
                "type": "array"
              },
              "allowed_tools": {
                "items": {
                  "type": "string"
                },
                "title": "Allowed Tools",
                "type": "array"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "title": "GuideStepItem",
            "type": "object"
          },
          "LookupGuideItem": {
            "properties": {
              "guide_id": {
                "title": "Guide Id",
                "type": "string"
              },
              "revision": {
                "description": "使った公開の版。",
                "title": "Revision",
                "type": "integer"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "decision": {
                "description": "answer=条件がそろった / branch=分岐で答えた / clarify=確かめる / handoff=人へ。",
                "enum": [
                  "answer",
                  "branch",
                  "clarify",
                  "handoff"
                ],
                "title": "Decision",
                "type": "string"
              },
              "known_conditions": {
                "items": {
                  "$ref": "#/$defs/GuideCondition"
                },
                "title": "Known Conditions",
                "type": "array"
              },
              "unknown_conditions": {
                "items": {
                  "$ref": "#/$defs/GuideCondition"
                },
                "title": "Unknown Conditions",
                "type": "array"
              },
              "expected_result": {
                "title": "Expected Result",
                "type": "string"
              },
              "score": {
                "description": "質問との照合の点（大きいほど合う）。",
                "title": "Score",
                "type": "integer"
              },
              "clarifications": {
                "items": {
                  "$ref": "#/$defs/GuideClarification"
                },
                "title": "Clarifications",
                "type": "array"
              },
              "steps": {
                "items": {
                  "$ref": "#/$defs/GuideStepItem"
                },
                "title": "Steps",
                "type": "array"
              },
              "impact_scope": {
                "enum": [
                  "individual",
                  "group",
                  "all"
                ],
                "title": "Impact Scope",
                "type": "string"
              },
              "approval_required": {
                "title": "Approval Required",
                "type": "boolean"
              },
              "handoff_contact": {
                "default": "",
                "title": "Handoff Contact",
                "type": "string"
              }
            },
            "required": [
              "guide_id",
              "revision",
              "title",
              "decision",
              "expected_result",
              "score",
              "impact_scope",
              "approval_required"
            ],
            "title": "LookupGuideItem",
            "type": "object"
          }
        },
        "properties": {
          "guides": {
            "description": "質問に当たる公開の業務ガイド（照合の点の高い順）。無ければ空。",
            "items": {
              "$ref": "#/$defs/LookupGuideItem"
            },
            "title": "Guides",
            "type": "array"
          }
        },
        "required": [
          "guides"
        ],
        "title": "LookupGuidesOutput",
        "type": "object"
      }
    },
    {
      "name": "rag_read_source",
      "description": "rag_search の根拠（document_id と chunk_id）の本文の続きと親の本文を読みます。検索と同じ利用範囲の根拠だけを読めます。",
      "inputSchema": {
        "additionalProperties": false,
        "description": "根拠の本文を読む条件（rag_search の evidence の document_id と chunk_id）。",
        "properties": {
          "document_id": {
            "description": "文書の id。",
            "maxLength": 128,
            "minLength": 1,
            "title": "Document Id",
            "type": "string"
          },
          "chunk_id": {
            "description": "根拠の chunk の id。",
            "maxLength": 512,
            "minLength": 1,
            "title": "Chunk Id",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "description": "本文の読み始めの位置（文字数）。",
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "max_chars": {
            "default": 8000,
            "description": "返す本文の最大文字数。",
            "maximum": 20000,
            "minimum": 1,
            "title": "Max Chars",
            "type": "integer"
          }
        },
        "required": [
          "document_id",
          "chunk_id"
        ],
        "title": "ReadSourceInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "$defs": {
          "EvidenceLocator": {
            "description": "根拠の場所（種類によって空の項目がある）。",
            "properties": {
              "section_path": {
                "description": "節の見出しの列。",
                "items": {
                  "type": "string"
                },
                "title": "Section Path",
                "type": "array"
              },
              "page_start": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "開始の頁（PDF の物理頁）。",
                "title": "Page Start"
              },
              "page_end": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "終了の頁（PDF の物理頁）。",
                "title": "Page End"
              },
              "sheet_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "表計算のシート名（#1221）。",
                "title": "Sheet Name"
              },
              "row_start": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "シートの開始の行（1 始まり）。",
                "title": "Row Start"
              },
              "row_end": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "シートの終了の行。",
                "title": "Row End"
              },
              "cell_range": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "セル範囲（例: A3:F7）。",
                "title": "Cell Range"
              }
            },
            "title": "EvidenceLocator",
            "type": "object"
          }
        },
        "properties": {
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "File Name"
          },
          "chunk_set_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chunk Set Id"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "content_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content Kind"
          },
          "locator": {
            "$ref": "#/$defs/EvidenceLocator"
          },
          "text": {
            "description": "offset から最大 max_chars 文字の本文。",
            "title": "Text",
            "type": "string"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "text_length": {
            "title": "Text Length",
            "type": "integer"
          },
          "truncated": {
            "description": "本文の続きがあるか。",
            "title": "Truncated",
            "type": "boolean"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "続きを読むときの offset。",
            "title": "Next Offset"
          },
          "parent_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "親の本文（前後の文脈。最大 max_chars 文字）。",
            "title": "Parent Text"
          },
          "parent_truncated": {
            "default": false,
            "title": "Parent Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "evidence_id",
          "document_id",
          "chunk_id",
          "locator",
          "text",
          "offset",
          "text_length",
          "truncated"
        ],
        "title": "ReadSourceOutput",
        "type": "object"
      }
    },
    {
      "name": "rag_search",
      "description": "検索・回答プロファイルのナレッジベースを検索し、根拠（evidence。場所・版・回答に使ったか付き）と回答を返します。",
      "inputSchema": {
        "additionalProperties": false,
        "description": "検索・回答の条件。旧 scope を含む未定義項目は拒否する。",
        "properties": {
          "query": {
            "description": "質問文。",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "search_answer_profile_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "検索・回答プロファイルの id。参照するナレッジベースと検索・回答設定を使う。",
            "title": "Search Answer Profile Id"
          },
          "knowledge_base_ids": {
            "description": "検索するナレッジベースの id（省略時は検索・回答プロファイルの参照先）。",
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "title": "Knowledge Base Ids",
            "type": "array"
          },
          "top_k": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "検索する件数。",
            "title": "Top K"
          },
          "filters": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "検索フィルター（例: category_name）。",
            "title": "Filters",
            "type": "object"
          },
          "evidence_limit": {
            "default": 12,
            "description": "返す根拠の最大件数（回答に使った根拠を先に返す）。",
            "maximum": 50,
            "minimum": 1,
            "title": "Evidence Limit",
            "type": "integer"
          },
          "conditions": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "業務ガイドの条件の値（条件の id → 値）。outcome=needs_clarification の clarifications に利用者が答えた値を入れて呼び直すと、分かっている条件は聞き直さない。",
            "maxProperties": 30,
            "title": "Conditions",
            "type": "object"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchInput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
