                "title": "Id",
                "type": "string"
              },
              "text": {
                "description": "要求の原文。",
                "title": "Text",
                "type": "string"
              },
              "status": {
                "description": "充足（addressed=答えた / partial=一部 / missing=答えていない / unknown=未確認）。",
                "enum": [
                  "addressed",
                  "partial",
                  "missing",
                  "unknown"
                ],
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
