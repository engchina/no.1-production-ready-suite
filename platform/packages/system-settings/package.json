{
  "name": "@engchina/production-ready-system-settings",
  "version": "0.1.0",
  "description": "Shared system settings pages (appearance / OCI / upload storage / model / database) for the No.1 Production Ready product family (RAG / NL2SQL / Agent).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@engchina/production-ready-ui": "*",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@engchina/production-ready-ui": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
