# Production Ready RAG — RAG 固有の設定（backend/.env。#211）
#
# このファイルを `backend/.env` にコピーして使う。変数名はすべて `RAG_` で始める。
# 3製品共通の設定（OCI 認証・アップロード保存先・モデル・データベース。`PLATFORM_*`）は
# 共通 `.env`（リポジトリの `platform/.env`、雛形は `platform/.env.example`）に置く。
# 読む順は 環境変数 → 共通 `.env` → この `backend/.env`。

# ===== アプリ =====
# RAG_ENVIRONMENT は local 環境の配備モードを兼ねる:
#   development(既定) → サービス管理画面の起動/停止: 前処理は uv 管理の Python プロセス、
#                        Parser(重い ML 依存)は docker compose(docker-compose.dev.yml で
#                        ポート公開)で行う(制御は自動有効。Parser は事前イメージ build を推奨)。
#   production         → 起動/停止は docker compose で行う(別途 RAG_SERVICE_CONTROL_ENABLED=true が必要)。
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_APP_VERSION=0.1.0
RAG_CORS_ORIGINS=["http://localhost:3000"]

# ===== 認証 =====
# local ではログイン/ログアウトを表示・要求しない。production では Cookie セッション認証を要求する。
RAG_AUTH_MODE=local
RAG_AUTH_USERNAME=
RAG_AUTH_PASSWORD=
RAG_AUTH_SESSION_SECRET=
RAG_AUTH_SESSION_TIMEOUT_SECONDS=86400
RAG_AUTH_COOKIE_NAME=production_ready_rag_session
RAG_AUTH_COOKIE_SECURE=false

# ===== HuggingFace モデルダウンロード =====
# 画面（運用設定 > HuggingFace 設定）から保存する。parser コンテナへは HF_TOKEN / HF_ENDPOINT として渡す。
RAG_HUGGINGFACE_TOKEN=
RAG_HUGGINGFACE_ENDPOINT=

# ===== Oracle 26ai（RAG 固有）=====
# 接続情報（PLATFORM_ORACLE_*）は共通 .env に置く。
RAG_ORACLE_VECTOR_TARGET_ACCURACY=95

# ===== アップロード =====
# 保存先（PLATFORM_UPLOAD_STORAGE_BACKEND / PLATFORM_LOCAL_STORAGE_DIR / PLATFORM_OBJECT_STORAGE_*）は共通 .env に置く。
RAG_MAX_UPLOAD_BYTES=209715200
RAG_ALLOWED_UPLOAD_CONTENT_TYPES=["application/pdf","image/jpeg","image/png","image/tiff","text/plain","application/octet-stream"]

# ===== 取込 queue =====
RAG_INGESTION_QUEUE_STARTUP_RECOVERY_ENABLED=true
RAG_INGESTION_QUEUE_STARTUP_DRAIN_LIMIT=50
RAG_INGESTION_QUEUE_STALE_RUNNING_SECONDS=300
RAG_INGESTION_QUEUE_RECOVERY_INTERVAL_SECONDS=60
RAG_INGESTION_QUEUE_WORKER_CONCURRENCY=2
RAG_INGESTION_JOB_MAX_ATTEMPTS=3
# HTTP リクエストは取込 job を投入するだけにし、取込本体は worker が消費します。
RAG_INGESTION_QUEUE_DEDICATED_WORKER_ENABLED=true
# ローカル開発では API process 内 dispatcher を起動し、job 本体は subprocess へ隔離します。
RAG_INGESTION_QUEUE_INPROCESS_WORKER_ENABLED=true
RAG_INGESTION_QUEUE_PROCESS_ISOLATION_ENABLED=true

# ===== RAG =====
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_CONTEXT_WINDOW_CHARS=12000
RAG_CONTEXT_NEIGHBOR_WINDOW=0
RAG_CONTEXT_DIVERSITY_LAMBDA=1.0
RAG_CONTEXT_COMPRESSION_ENABLED=false
RAG_CONTEXT_COMPRESSION_MAX_SENTENCES=3
RAG_CONTEXT_COMPRESSION_MAX_CHARS_PER_CHUNK=1200
RAG_MIN_SIMILARITY=0.05
RAG_RRF_K=60
RAG_QUERY_EXPANSION_ENABLED=true
RAG_QUERY_EXPANSION_MAX_VARIANTS=3
RAG_SEARCH_TIMEOUT_SECONDS=30
RAG_PDF_SEGMENTATION_ENABLED=true
RAG_PDF_MAX_PAGES_PER_SEGMENT=10
RAG_PDF_MAX_SEGMENTS=300
# 2 段階処理(parse → 人がプレビュー確認 → index)。true で抽出後 REVIEW で停止し、
# 承認 API 経由で索引する。false(既定)は従来どおり 1 ジョブで INDEXED まで一気通貫。
RAG_REVIEW_GATE_ENABLED=false

# ===== 前処理マイクロサービス(parse 前の原本変換)=====
# 1 変換 = 1 独立サービス。RAG_PREPROCESS_PROFILE で選択し、委譲は RAG_PREPROCESS_ENABLED で有効化。
# 既定は passthrough(変換なし)。in-process 変換は持たず、選択した変換サービスが未達/失敗なら
# 別経路へ縮退せず利用者向けエラーで取込を止める(fail-fast)。
# URL は docker 名(prod 用)。dev(RAG_ENVIRONMENT=development)では backend が catalog の dev_port
# (127.0.0.1:18010-18016)へ自動で問い合わせるため、この URL の編集は不要。
RAG_PREPROCESS_ENABLED=true
RAG_PREPROCESS_OFFICE_TO_PDF_SERVICE_URL=http://preprocess-office-to-pdf:8000
RAG_PREPROCESS_PDF_TO_PAGE_IMAGES_SERVICE_URL=http://preprocess-pdf-to-page-images:8000
RAG_PREPROCESS_CSV_TO_JSON_SERVICE_URL=http://preprocess-csv-to-json:8000
RAG_PREPROCESS_EXCEL_TO_JSON_SERVICE_URL=http://preprocess-excel-to-json:8000
RAG_PREPROCESS_SERVICE_TIMEOUT_SECONDS=300

# ===== サービス管理(起動/停止)=====
# サービス管理画面の起動/停止は配備モードで分岐する:
#   dev(RAG_ENVIRONMENT=development) → uv 管理のローカル Python プロセス(制御は自動有効。下記フラグ不要)。
#   prod(RAG_ENVIRONMENT=production) → docker compose 制御。明示的に RAG_SERVICE_CONTROL_ENABLED=true が必要で、
#                                  backend が docker CLI を実行できること(docker.sock + CLI のマウント等)。
RAG_SERVICE_CONTROL_ENABLED=false
RAG_SERVICE_CONTROL_COMMAND=docker compose
RAG_SERVICE_CONTROL_TIMEOUT_SECONDS=60
RAG_SERVICE_STATUS_PROBE_TIMEOUT_SECONDS=5

# ===== 文書解析 =====
# CPU 解析は parser マイクロサービスへ HTTP 委譲する(in-process 解析・local fallback は持たない)。
# Unlimited-OCR / MinerU / Dots.OCR / GLM-OCR は外部運用済み API へ直接接続する。
# 既定 backend は Unstructured(simple 形式の catch-all)。取込には parser-unstructured の常時起動が前提。
# 選択 backend が未達/空振りなら別経路へ縮退せず fail-fast で取込を止める。
# スキャン PDF 等の OCR は oci_genai_vision / oci_document_understanding / GPU OCR を明示選択する。
RAG_PARSER_ADAPTER_BACKEND=unstructured
RAG_PARSER_UNSTRUCTURED_ENABLED=true
RAG_PARSER_DOCLING_SERVICE_URL=http://parser-docling:8000
RAG_PARSER_MARKER_SERVICE_URL=http://parser-marker:8000
RAG_PARSER_UNSTRUCTURED_SERVICE_URL=http://parser-unstructured:8000
# 外部 GPU parser。Endpoint は未設定を既定とし、旧 *_SERVICE_URL は自動移行しない。
# *_API_KEY は画面（文書解析）から保存すると、この backend/.env に書かれる。
RAG_PARSER_UNLIMITED_OCR_API_HOST=
RAG_PARSER_UNLIMITED_OCR_MODEL=/models/Unlimited-OCR
RAG_PARSER_UNLIMITED_OCR_API_KEY=
RAG_PARSER_MINERU_API_HOST=
RAG_PARSER_MINERU_API_KEY=
RAG_PARSER_MINERU_LANGUAGE=japan
RAG_PARSER_DOTS_OCR_API_HOST=
RAG_PARSER_DOTS_OCR_MODEL=rednote-hilab/dots.mocr
RAG_PARSER_DOTS_OCR_API_KEY=
RAG_PARSER_GLM_OCR_API_HOST=
RAG_PARSER_GLM_OCR_MODEL=ggml-org/GLM-OCR-GGUF:f16
RAG_PARSER_GLM_OCR_API_KEY=
RAG_PARSER_SERVICE_TIMEOUT_SECONDS=300
# readiness 画面の version/可用性を parser サービスの /health で表示する(compose/本番で true)。
RAG_PARSER_READINESS_PROBE_ENABLED=false
RAG_PARSER_READINESS_PROBE_TIMEOUT_SECONDS=2

# ===== service 系 parser backend(OCI クラウドサービス直呼び)=====
# RAG_PARSER_ADAPTER_BACKEND=enterprise_ai_vlm を選ぶと、fallback ではなく明示的に
# OCI Enterprise AI VLM で OCR/抽出する(別 env は不要、Enterprise AI 設定を再利用)。
#
# RAG_PARSER_ADAPTER_BACKEND=oci_document_understanding を選ぶと、別 OCI サービス
# OCI Document Understanding(oci.ai_document)の非同期 processor job で日本語 OCR/表抽出する。
# 入出力は Object Storage 経由。明示選択した service backend が未設定/失敗なら別経路へ縮退せず取込を止める。
# compartment / namespace / 入力 bucket が空なら、それぞれ汎用の PLATFORM_OCI_COMPARTMENT_ID /
# PLATFORM_OBJECT_STORAGE_NAMESPACE / PLATFORM_OBJECT_STORAGE_BUCKET を使う。
RAG_OCI_DOCUMENT_UNDERSTANDING_COMPARTMENT_ID=
RAG_OCI_DOCUMENT_UNDERSTANDING_NAMESPACE=
RAG_OCI_DOCUMENT_UNDERSTANDING_INPUT_BUCKET=
RAG_OCI_DOCUMENT_UNDERSTANDING_OUTPUT_BUCKET=
RAG_OCI_DOCUMENT_UNDERSTANDING_INPUT_PREFIX=document-understanding/input
RAG_OCI_DOCUMENT_UNDERSTANDING_OUTPUT_PREFIX=document-understanding/output
RAG_OCI_DOCUMENT_UNDERSTANDING_LANGUAGE=JPN
RAG_OCI_DOCUMENT_UNDERSTANDING_POLL_INTERVAL_SECONDS=5
RAG_OCI_DOCUMENT_UNDERSTANDING_TIMEOUT_SECONDS=600

# ===== ガードレール =====
RAG_GUARDRAIL_MAX_QUERY_CHARS=2000
RAG_GUARDRAIL_BLOCK_PROMPT_INJECTION=true

# ===== 監査 =====
# tenant/user id header を監査ログへ hash 化するときの任意 salt。Production では OCI Vault から注入する。
RAG_AUDIT_CONTEXT_HASH_SALT=

# ===== Trace export =====
# OpenTelemetry / Langfuse 連携用 gateway へ脱機密化済み trace span event を非同期 POST する。
# 空なら構造化ログ + Prometheus のみ。
RAG_TRACE_EXPORT_HTTP_ENDPOINT=
RAG_TRACE_EXPORT_HTTP_BEARER_TOKEN=
RAG_TRACE_EXPORT_TIMEOUT_SECONDS=2
RAG_TRACE_EXPORT_QUEUE_SIZE=1024

# --- DocRAG(rag_poc)移植機能(docs/docrag-port.md)。既定値は移植前と同じ ---
# Docling 解析で図・画像入りの表を Vision で説明する(文書レシピで上書き可)
RAG_PARSER_DOCLING_VISION_ENABLED=false
# 回答エンジン: standard / docrag(業務ビューで上書き可)
RAG_ANSWER_ENGINE=standard
# Oracle Text クエリの分割方式: builtin / sudachi(業務ビューで上書き可)
RAG_TEXT_SEARCH_TOKENIZER=builtin
# DocRAG 回答の質問拡張戦略: auto_routing / simple_retrieval / rag_fusion / query_decomposition / step_back_prompting / hyde(業務ビューで上書き可)
RAG_DOCRAG_QUERY_STRATEGY=auto_routing
# DocRAG 回答の回答生成フロー: crag / standard_rag(業務ビューで上書き可)
RAG_DOCRAG_ANSWER_FLOW=crag
# DocRAG 回答で根拠の前後から足す近傍 child 数: 0〜20(業務ビューで上書き可)
RAG_DOCRAG_NEIGHBOR_CHILD_COUNT=3
# DocRAG 回答で検索候補を rerank で並べ替える(業務ビューで上書き可)
RAG_DOCRAG_RERANK_ENABLED=true
# 類似問(Approved FAQ)の照合に embedding の意味類似度を加える
RAG_APPROVED_FAQ_SEMANTIC_ENABLED=true
# DocRAG 回答で根拠の図を回答モデルへ添付する(回答モデルが画像入力対応の場合のみ)
RAG_DOCRAG_ANSWER_VISION_ENABLED=false
# 業務固有の問い合わせ規則: generic / legacy(legacy は DOCRAG_DOMAIN_PROFILE_FILE の JSON を読む)
RAG_DOCRAG_PROFILE=generic
# DOCRAG_DOMAIN_PROFILE_FILE=/path/to/domain_profile.json
# 質問履歴: 回答に成功した質問を業務ビュー単位で保存し、よく聞かれる質問を RAG 検索の候補に出す(既定は無効)
RAG_QUERY_HISTORY_ENABLED=false
RAG_QUERY_HISTORY_RETENTION_DAYS=90
RAG_QUERY_HISTORY_MIN_COUNT=3
RAG_QUERY_HISTORY_SUGGESTION_LIMIT=5
# 記録・提示しない語(部分一致)の JSON 配列
RAG_QUERY_HISTORY_BLOCKLIST=[]
