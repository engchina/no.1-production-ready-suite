# Production Ready RAG — RAG 固有の設定（backend/.env。#211）
#
# このファイルを `backend/.env` にコピーして使う。変数名はすべて `RAG_` で始める。
# 3製品共通の設定（OCI 認証・アップロード保存先・モデル・データベース。`PLATFORM_*`）は
# 共通 `.env`（リポジトリの `platform/.env`、雛形は `platform/.env.example`）に置く。
# 読む順は 環境変数 → 共通 `.env` → この `backend/.env`。
# 用途別に配置し、工程の設定は初めに使う順を目安に並べる。分岐・再検索で工程を繰り返す場合もある。

# ===== 実行基盤・共通の認証 =====
RAG_LOG_LEVEL=INFO
RAG_APP_VERSION=0.1.0
RAG_CORS_ORIGINS=["http://localhost:3000"]

# 環境と認証方式は platform/.env の PLATFORM_ENVIRONMENT / PLATFORM_AUTH_MODE で指定する。
# local: 全権限・対象範囲の制限なしのローカル利用者として動かす（ログイン不要。開発・CI 用）。
# authenticated: 共通認証（ユーザー・ロールは PLATFORM_* テーブル）のログインを要求する。
# 構成管理者（PLATFORM_ADMIN_*）と認証ポリシー（PLATFORM_AUTH_*）は共通 .env（platform/.env）に置く。
# ログインの Cookie は 3 製品で共有する（名前は platform/.env の PLATFORM_AUTH_*_COOKIE_NAME。#1565）。

# ===== 接続・モデルダウンロード =====
# 画面（運用設定 > HuggingFace 設定）から保存する。parser には、サービス管理が起動/再起動の前に
# HF_TOKEN / HF_ENDPOINT としてサービス実行用の env ファイル（backend/service-runtime.env）で渡す。
RAG_HUGGINGFACE_TOKEN=
RAG_HUGGINGFACE_ENDPOINT=

# 接続情報（PLATFORM_ORACLE_*）は共通 .env に置く。
# backend の接続 pool の上限。回答の検索は検索文をまとめた vector / keyword の SQL を並行に読む（#1498）。
RAG_ORACLE_POOL_MAX=16
# backend（API）の起動時に開いておく接続の数（pool の min。起動直後の問で接続の作成を待たない。#1498）。
RAG_ORACLE_POOL_MIN=4

# ===== 共通の AI 呼出し・再試行・用途別の推論量 =====
# 再試行の待ち(指数の backoff と full jitter。Retry-After があればそれを優先)の上限の秒数。
RAG_AI_CALL_BACKOFF_MAX_SECONDS=60
# 再試行を使い切った件を、段の最後にまとめてもう一度呼ぶ前の待ちの秒数。
RAG_AI_CALL_FINAL_RETRY_DELAY_SECONDS=30
# true で、最後の再試行でも失敗した件(説明できなかった図など)があれば取込を失敗にする。既定は記録して続ける。
RAG_AI_CALL_FAIL_JOB_ON_ITEM_ERROR=false
# 回答文の生成の LLM の推論(思考)の量(#1499)。model はモデルの登録値のまま、none は送らない、
# low / medium / high はその値を送る(モデルの登録値が none のモデルには送らない)。
RAG_GENERATION_REASONING_EFFORT=model
# 回答の LLM の呼び出しを streaming で受け、応答の event がこの秒だけ来なければ止まったとして打ち切って
# 送り直す(#1926・#4736。止まった判定は無音だけで、遅いだけの出力は打ち切らない)。
# 送り直しは、やり直しの共通の枠(1 回の呼び出しで最大 2 回)で数える。全体の上限は RAG_ANSWER_TIMEOUT_SECONDS。
RAG_LLM_STALL_DETECTION_ENABLED=true
# 一時的な通信障害・出力形式不正の再試行。0 は再試行なし。回答全体の期限を共有する。
RAG_LLM_MAX_RETRIES=1
RAG_LLM_STALL_IDLE_SECONDS=120

# ===== サービス管理（工程をまたぐ起動・停止） =====
# 実行環境は platform/.env の PLATFORM_ENVIRONMENT（既定 staging）。
# サービス管理画面は、前処理 / parser の systemd の unit(production-ready-rag-<service>.service)を操作する(#286)。
#   起動 = systemctl enable --now、停止 = systemctl disable --now(最後に操作した状態を再起動・再配備でも保つ)、
#   再起動 = systemctl restart、ログ = journalctl -u <unit>。どれも sudoers で許可した unit だけを sudo -n で実行する。
#   dev(PLATFORM_ENVIRONMENT=local) → 制御は自動で有効(下記フラグ不要)。
#   staging / prod(PLATFORM_ENVIRONMENT=staging / production) → 下の RAG_SERVICE_CONTROL_ENABLED を true に
#     明示したときだけ(Terraform の stack は true)。
RAG_SERVICE_CONTROL_ENABLED=false
RAG_SERVICE_CONTROL_TIMEOUT_SECONDS=60
RAG_SERVICE_STATUS_PROBE_TIMEOUT_SECONDS=5

# ===== アップロード =====
# 保存先（PLATFORM_UPLOAD_STORAGE_BACKEND / PLATFORM_LOCAL_STORAGE_DIR / PLATFORM_OBJECT_STORAGE_*）は共通 .env に置く。
RAG_MAX_UPLOAD_BYTES=209715200
RAG_ALLOWED_UPLOAD_CONTENT_TYPES=["application/pdf","image/jpeg","image/png","text/plain","application/octet-stream"]
# Office テンプレート(.dotx / .dotm / .potx / .potm / .xltx / .xltm)の原本を保存する前に確かめる上限(#4054)。
RAG_OFFICE_TEMPLATE_MAX_MEMBERS=20000
RAG_OFFICE_TEMPLATE_MAX_UNCOMPRESSED_BYTES=536870912

# ===== 取込実行・queue =====
RAG_INGESTION_QUEUE_STARTUP_RECOVERY_ENABLED=true
RAG_INGESTION_QUEUE_STARTUP_DRAIN_LIMIT=50
# heartbeat の無い RUNNING job（lease 導入前の行）を stale とみなす秒数。
RAG_INGESTION_QUEUE_STALE_RUNNING_SECONDS=300
# worker は自分の lease の RUNNING job に heartbeat を打ち、heartbeat が TTL を超えて途絶えた job だけを回復する（#357）。
# TTL は heartbeat 間隔の 3 倍以上。job の長さの上限は job の timeout だけが持つ。
RAG_INGESTION_QUEUE_HEARTBEAT_INTERVAL_SECONDS=15
RAG_INGESTION_QUEUE_LEASE_TTL_SECONDS=90
# 停止（SIGTERM）後に実行中の job を待つ上限。超えたら子を止め、job を QUEUED に戻す。
RAG_INGESTION_QUEUE_SHUTDOWN_GRACE_SECONDS=60
RAG_INGESTION_QUEUE_RECOVERY_INTERVAL_SECONDS=60
# 同時実行数（#2027）。auto は vCPU から決める: 全体 max(2, vCPU − 2)、重い段（ファイル準備・抽出）
# max(1, (vCPU − 2) // 3)。数を書けばその値（1〜16。重い段 ≤ 全体）。
RAG_INGESTION_QUEUE_WORKER_CONCURRENCY=auto
RAG_INGESTION_QUEUE_HEAVY_PHASE_CONCURRENCY=auto
# 続きの段（Chunk 作成・索引）を、その文書の最初の段の投入の時刻まで繰り上げて取る上限（秒。0 で投入の順）。
RAG_INGESTION_QUEUE_PIPELINE_PRIORITY_WINDOW_SECONDS=3600
RAG_INGESTION_JOB_MAX_ATTEMPTS=3
# HTTP リクエストは取込 job を投入するだけにし、取込本体は worker が消費します。
RAG_INGESTION_QUEUE_DEDICATED_WORKER_ENABLED=true
# ローカル開発では API process 内 dispatcher を起動し、job 本体は subprocess へ隔離します。
RAG_INGESTION_QUEUE_INPROCESS_WORKER_ENABLED=true
RAG_INGESTION_QUEUE_PROCESS_ISOLATION_ENABLED=true
# subprocess の job の止め方（#2003）。worker は job の進捗（解析のページ・図・表の説明の件数）を
# heartbeat の間隔で読み、その段の途中で STALL の秒数進まなければ止める（進んでいる job は止めない）。
# STALL は進捗を出さない 1 回の呼び出し（解析サービス・Document Understanding・Vision の LLM。
# 再試行を含む）の最長より長くする（短いと起動時の検証で止まる）。
RAG_INGESTION_JOB_STALL_TIMEOUT_SECONDS=7200
# 全体の上限（保険。進んでいても止める）。1 文書 1,000 図を 1 件 60 秒で順に読んでも足りる 24 時間。上限 7 日。
RAG_INGESTION_JOB_SUBPROCESS_TIMEOUT_SECONDS=86400

# ===== ファイル準備（解析前の原本変換） =====
# 1 変換 = 1 独立サービス。RAG_PREPROCESS_PROFILE で選択し、委譲は RAG_PREPROCESS_ENABLED で有効化。
# 既定は passthrough(変換なし)。in-process 変換は持たず、選択した変換サービスが未達/失敗なら
# 別経路へ縮退せず利用者向けエラーで取込を止める(fail-fast)。
# URL の既定は各サービスが listen する 127.0.0.1:<port>(18010・18012・18013・18017。backend のサービスカタログと同じ)。
# 以前の Docker Compose の service 名(http://preprocess-office-to-pdf:8000 など)は読み替えない(#356)。127.0.0.1:<port> に直す。
RAG_PREPROCESS_ENABLED=true
RAG_PREPROCESS_OFFICE_TO_PDF_SERVICE_URL=http://127.0.0.1:18010
RAG_PREPROCESS_CSV_TO_JSONL_SERVICE_URL=http://127.0.0.1:18012
RAG_PREPROCESS_EXCEL_TO_JSONL_SERVICE_URL=http://127.0.0.1:18013
# 前処理 excel_to_jsonl の既定の選択肢(JSON。#1221)。文書レシピの「Excel の読み方」で上書きできる。
# mode: auto / table / procedure、header_row(1 始まり。null は推定)、header_row_count、sheets、exclude_sheets、
# include_hidden_sheets、exclude_columns(列名か列の記号)。
# RAG_PREPROCESS_EXCEL_OPTIONS={"mode": "auto"}
# Word(.doc/.docx/.docm/.dotx/.dotm)→構造化レコード JSONL(#2457)。.doc は LibreOffice で .docx にしてから読む。
RAG_PREPROCESS_WORD_TO_JSONL_SERVICE_URL=http://127.0.0.1:18017
RAG_PREPROCESS_SERVICE_TIMEOUT_SECONDS=300

# ===== 文書解析・接続先 =====
# CPU 解析は parser マイクロサービスへ HTTP 委譲する(in-process 解析・local fallback は持たない)。
# Dots.OCR は外部運用済み API へ直接接続する。
# 既定 backend は Docling(#286)。取込には parser-docling の常時起動が前提。
# 既定の Docling は PDF と画像だけを解析する。それ以外(テキスト・HTML・Office・メール など)は取込を始める前に止まり、
# 処理レシピで Unstructured を選ぶよう案内する(自動では振り分けない。#286)。Unstructured(.eml 等も受ける汎用 partition)を
# 使う場合は unstructured を選び、parser-unstructured を配備・起動する(本番は stack の rag_enable_parser_unstructured)。
# 選択 backend が未達/空振りなら別経路へ縮退せず fail-fast で取込を止める。
# スキャン PDF 等の OCR は oci_document_understanding / GPU OCR を明示選択する。
# 画面（文書解析）から保存した解析エンジンと接続は RAG_PARSER_SETTINGS_FILE（相対パスはこのファイルの
# 場所から）に書かれ、下の値より優先する。共有の model-settings.json には書かない（#1701）。
RAG_PARSER_SETTINGS_FILE=parser-settings.json
# 画面（形式別の既定）から保存した種類ごとのファイル準備・解析エンジン・分割方式。相対パスはこのファイルの場所から。
RAG_FILE_TYPE_DEFAULTS_FILE=file-type-defaults.json
RAG_PARSER_ADAPTER_BACKEND=docling
RAG_PARSER_DOCLING_ENABLED=true
RAG_PARSER_UNSTRUCTURED_ENABLED=false
RAG_PARSER_DOCLING_SERVICE_URL=http://127.0.0.1:18020
RAG_PARSER_UNSTRUCTURED_SERVICE_URL=http://127.0.0.1:18022
# 前処理（csv_to_jsonl / excel_to_jsonl / word_to_jsonl）の構造化レコードの JSONL は structured_records_jsonl を使用エンジンに
# 選んだときだけ parser-structured-records-jsonl で記録の単位に解析する（#2457）。
RAG_PARSER_STRUCTURED_RECORDS_JSONL_ENABLED=false
RAG_PARSER_STRUCTURED_RECORDS_JSONL_SERVICE_URL=http://127.0.0.1:18023
# XML ツリー JSON（tag / attr / children の木の JSON）は xml_tree_json を使用エンジンに選んだときだけ
# parser-xml-tree-json で解析する（形式で自動には振り分けない。#2042）。
RAG_PARSER_XML_TREE_JSON_ENABLED=false
RAG_PARSER_XML_TREE_JSON_SERVICE_URL=http://127.0.0.1:18021
# 引用カードの「原典を開く」の URL のひな形（{document_id} を文書 ID に置き換える。https だけ。空なら出さない）。
RAG_XML_TREE_JSON_SOURCE_URL_TEMPLATE=
# 外部 GPU parser。Endpoint は未設定を既定とし、旧 *_SERVICE_URL は自動移行しない。
# *_API_KEY は画面（文書解析）から保存すると、この backend/.env に書かれる。
RAG_PARSER_DOTS_OCR_API_HOST=
RAG_PARSER_DOTS_OCR_MODEL=rednote-hilab/dots.mocr
RAG_PARSER_DOTS_OCR_API_KEY=
RAG_PARSER_SERVICE_TIMEOUT_SECONDS=300
# readiness 画面の version/可用性を parser サービスの /health で表示する(本番の unit で true)。
RAG_PARSER_READINESS_PROBE_ENABLED=false
RAG_PARSER_READINESS_PROBE_TIMEOUT_SECONDS=2
# 解析エンジン(RAG_PARSER_ADAPTER_BACKEND)に enterprise_ai_vlm を選ぶと、fallback ではなく明示的に
# OCI Enterprise AI VLM で OCR/抽出する(別 env は不要、Enterprise AI 設定を再利用)。
#
# 解析エンジン(RAG_PARSER_ADAPTER_BACKEND)に oci_document_understanding を選ぶと、別 OCI サービス
# OCI Document Understanding(oci.ai_document)の非同期 processor job で日本語 OCR/表抽出する。
# 入出力は Object Storage 経由。明示選択した service backend が未設定/失敗なら別経路へ縮退せず取込を止める。
# compartment / namespace / 入力 bucket が空なら、それぞれ汎用の PLATFORM_OCI_COMPARTMENT_ID /
# PLATFORM_OBJECT_STORAGE_NAMESPACE / PLATFORM_OBJECT_STORAGE_BUCKET を使う。
RAG_OCI_DOCUMENT_UNDERSTANDING_COMPARTMENT_ID=
RAG_OCI_DOCUMENT_UNDERSTANDING_NAMESPACE=
RAG_OCI_DOCUMENT_UNDERSTANDING_INPUT_BUCKET=
RAG_OCI_DOCUMENT_UNDERSTANDING_OUTPUT_BUCKET=
RAG_OCI_DOCUMENT_UNDERSTANDING_INPUT_PREFIX=document-understanding/input
RAG_OCI_DOCUMENT_UNDERSTANDING_OUTPUT_PREFIX=document-understanding/output
RAG_OCI_DOCUMENT_UNDERSTANDING_LANGUAGE=JPN
RAG_OCI_DOCUMENT_UNDERSTANDING_POLL_INTERVAL_SECONDS=5
RAG_OCI_DOCUMENT_UNDERSTANDING_TIMEOUT_SECONDS=600

# ===== 文書解析・PDF の分割とページの接続 =====
# PDF をページの段に分け、段ごとに解析サービス（Docling など）を呼ぶ（#2001）。段ごとに状態・進捗・
# 抽出結果を残し、失敗・中断の後は成功した段を解析し直さない。並行の数（1〜4）は既定 1（順番）。
RAG_PDF_SEGMENTATION_ENABLED=true
RAG_PDF_MAX_PAGES_PER_SEGMENT=10
RAG_PDF_MAX_SEGMENTS=300
RAG_PDF_SEGMENT_PARSE_CONCURRENCY=1
# ページの境目で切れた段落の続きの判定の行の位置（#2273）。PDF の文字の層の行で、前の段落の最後の行が
# 右端まで届く・次の段落の最初の行に字下げが無い・段落の幅が近いことを確かめる（文字の層の無いページ・
# 縦書き・回転したページは文の終わりの規則だけ）。右端と字下げの許容は行の高さの倍数、幅の差は狭いほうの
# 幅の倍数。変更は次に解析する文書から効く。
RAG_PAGE_CONTINUATION_GEOMETRY_ENABLED=true
RAG_PAGE_CONTINUATION_RIGHT_EDGE_TOLERANCE=1.0
RAG_PAGE_CONTINUATION_INDENT_TOLERANCE=0.5
RAG_PAGE_CONTINUATION_WIDTH_DIFFERENCE_RATIO=1.0

# ===== 解析後の処理・図と画像の読み取り =====
# 解析の後に図・画像(と画像入りの表)を既定の Vision モデルで読み取り、図の要素の本文を説明文にする。
# 全ての解析エンジンで使える。全体の既定はこの env で決め、文書レシピで上書きする(#497)。
# 文書解析の画面の「解析後の処理」から保存すると、この値を書き換える(#528)。
# 旧 RAG_PARSER_DOCLING_VISION_ENABLED / RAG_ASSET_SUMMARY_ENABLED / RAG_ASSET_SUMMARY_MAX_ASSETS は読まない。
# 既定は有効(#537)。画像 1 枚ごとに既定の Vision モデルを呼ぶ。
RAG_VISION_ENABLED=true
# 画像の用途: record（実データ・記録）/ example（画面例・説明用）。変更は再解析で反映します。
RAG_VISION_IMAGE_PURPOSE=record
# 取込の AI の呼び出しの並行と再試行(#2002。共通の部品 pr_backend_core.bounded_calls)。
# 段ごとの同時の呼び出しの上限。429(流量の制限)を受けると全体で待ち、並行の数を半分(最小 1)にして、
# 成功が続くとこの上限まで戻す。Vision は同じページの図を順番に読む(説明の内容・順番を変えない)。
# PDF を段ごとに解析するときは、段の解析が終わった段の図から読み始め、次の段の解析と並べる。
# Vision の上限は文書解析の画面の「解析後の処理」からも保存する。
RAG_VISION_CONCURRENCY=4

# ===== 解析後の処理・見出しの階層の推定 =====
# しおりも番号も無い文書の見出しの階層を OCI Enterprise AI で推定する(#2277。既定は無効)。見出しの文字列だけを
# 渡し、応答の形が合わない・失敗のときは今の階層のまま取込を続ける。全体の既定で、文書レシピで上書きする。
# 「解析後の処理」から保存すると、この値を書き換える。対象は見出しが MIN〜MAX 件で、番号で深さを決められない見出しの
# 割合が UNRESOLVED_RATIO 以上の文書(Docling の結果)だけ。
RAG_HEADING_LEVEL_INFERENCE_ENABLED=false
RAG_HEADING_LEVEL_INFERENCE_MIN_HEADINGS=3
RAG_HEADING_LEVEL_INFERENCE_MAX_HEADINGS=300
RAG_HEADING_LEVEL_INFERENCE_UNRESOLVED_RATIO=0.5
RAG_HEADING_LEVEL_INFERENCE_MAX_TITLE_CHARS=120

# ===== 解析後の処理・項目抽出 =====
# 項目の定義(文書解析の画面の「解析後の処理」)に従って項目を抽出する。既定は無効(#2839)。定義が 0 件なら何もしない。
RAG_FIELD_EXTRACTION_ENABLED=false
# 項目抽出の 1 回の要求の入力の予算(既定のテキストモデルの「入力の上限（tokens）」に対する %。10〜90。#2720)。
# 指示・項目の定義を含めてこの予算に収まるように本文を見出し・段落・表の境界で分けて抽出し、結果を統合する。
RAG_FIELD_EXTRACTION_INPUT_TOKEN_PERCENT=40

# ===== 解析後の処理・章節の要約 =====
# 取込時に章節ナビゲーションの各章節を OCI Enterprise AI で要約し、章節をたどる検索に使う(既定は無効)。
# 「解析後の処理」から保存すると、この値を書き換える
RAG_NAVIGATION_SUMMARY_ENABLED=false
RAG_NAVIGATION_SUMMARY_CONCURRENCY=4

# ===== 抽出後のレビューと索引への承認 =====
# 2 段階処理(parse → 人がプレビュー確認 → index)。true で抽出後 REVIEW で停止し、
# 承認 API 経由で索引する。false(既定)は従来どおり 1 ジョブで INDEXED まで一気通貫。
RAG_REVIEW_GATE_ENABLED=false
# 抽出の修正の履歴にレシピごとに残す版の数(#2644)。今の版・基の解析の版・検索に出している版は古くても残す。
# RAG_EXTRACTION_MAX_REVISIONS=20
# 人が修正した章節の履歴に文書ごとに残す版の数(#4171)。今の版は古くても残す。
# RAG_SECTION_MAX_REVISIONS=20

# ===== 文書分割・文脈ヘッダ =====
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# 分割方式 fixed_delimiter だけが優先度順に試す分割符(JSON の配列。既定は記録の境界だけ)。
RAG_CHUNK_DELIMITER=["<<<JSONL_RECORD_BOUNDARY>>>"]
# structure_aware / recursive_character / small_to_big が本文を切るときに優先度順に試す区切り(JSON の配列)。
# markdown_heading / page_level / fixed_delimiter / fixed_size は使わない。変えると使う方式の文書は再処理の案内が出る。
RAG_CHUNK_SEPARATORS=["\n\n","\n","。","！","？",". ","! ","? ","；",";"]
# 文脈ヘッダは全体の環境設定で使う。画面・文書レシピでは切り替えない。
RAG_CHUNK_CONTEXT_HEADER_ENABLED=true

# ===== Embedding・検索索引 =====
RAG_EMBEDDING_CONCURRENCY=2
RAG_ORACLE_VECTOR_TARGET_ACCURACY=95

# ===== 索引保存後の実体・別名索引 =====
# 実体の層(#1362): 取込の索引の保存の後に、表の行・本文の定義の形から実体と「実体と chunk の関連」を
# 決定的に作る(LLM は使わない)。全体の既定は OFF(#3008)で、名称・別名の索引の設定画面と文書レシピで
# 有効・無効を選べる。回答の検索に使うかは、検索方法の「名称・別名でつながる根拠」で選ぶ。
RAG_ENTITY_INDEX_ENABLED=false
# 実体の抽出で、表の行の名前・属性にする列名(JSON の配列。空なら列名で決める)。文書レシピで上書きする。
RAG_ENTITY_NAME_COLUMNS=[]
RAG_ENTITY_ATTRIBUTE_COLUMNS=[]

# ===== 索引保存後の文書の要約 =====
# 取込（分割・埋め込み・索引）が終わって検索に出した後に、文書全体の要約を 1 文書につき 1 回の LLM
# （OCI Enterprise AI）で作る(#4793)。要約は文書の説明として文書の詳細に出し、要約の chunk を 1 つ索引に入れて
# 「何の文書か」のような文書全体を問う質問の検索に当てる。既定は有効。失敗・時間切れでも取込は失敗にせず、
# 文書の詳細から作り直せる。全体の設定だけで、文書レシピでは上書きしない。
# 文書解析の画面の「解析後の処理」から保存すると、この値を書き換える。
RAG_DOCUMENT_SUMMARY_ENABLED=true
# 入力の予算(文字数。2000〜200000)。本文は文書の先頭からこの予算まで渡す。超える文書は、予算の 1/4 までの
# 見出しの一覧を足し、本文を省いたことを入力に書く。
RAG_DOCUMENT_SUMMARY_MAX_INPUT_CHARS=16000
# 1 文書あたりの時間の上限(秒。再試行・埋め込み・保存を含む)。超えたら要約なしとして記録する。
RAG_DOCUMENT_SUMMARY_TIMEOUT_SECONDS=120

# Wiki は KB で構築を有効にし、検索・回答プロファイルで使用を有効にする（両方とも既定は無効）。
# 背景構築の入力・出力対象数。出力が途切れた対象は小さい批次に分け、完了した単位は再利用する。
RAG_WIKI_BUILD_INPUT_CHARS=120000
RAG_WIKI_BUILD_BATCH_UNITS=24
RAG_WIKI_BUILD_TIMEOUT_SECONDS=600
RAG_WIKI_BUILD_WORKERS=2
RAG_WIKI_LEASE_SECONDS=900
RAG_WIKI_POLL_SECONDS=30
# 検索用の埋め込みへ添える原文の長さ。引用用の原文は切らない。
RAG_WIKI_EMBEDDING_SOURCE_CHARS=4096
# Wiki の候補数と、精細な補読で選べる単位数。既存検索との最終結合では再順位付けしない。
RAG_WIKI_CANDIDATES=100
RAG_WIKI_SELECTED_DOCUMENTS=8
RAG_WIKI_SELECTED_UNITS=32
RAG_WIKI_SELECTED_SECTIONS=24
RAG_WIKI_UNIT_PREVIEW_CHARS=500
RAG_WIKI_SECTION_PREVIEW_CHARS=240
RAG_WIKI_SECTION_CATALOG_LIMIT=48
RAG_WIKI_QUERY_TIMEOUT_SECONDS=180

# ===== 質問の準備・業務ガイドと類似問の照合 =====
# 業務ガイドの照合(#2398)。照合の前に、検索・回答プロファイルの用語の別名で質問を展開する(常に行う)。
# 意味の照合: 質問と質問の例の埋め込み(OCI Generative AI)の近さが閾値以上なら点を足す(既定は無効。
# 質問ごとに埋め込みの呼び出しが 1 回増える)。全体設定だけで決める(#4784)
# 使用の総合スイッチ。検索・回答プロファイルも明示的に ON にしたときだけ利用する。
# RAG_SUPPORT_GUIDE_ENABLED=false
# RAG_SUPPORT_GUIDE_SEMANTIC_MATCH_ENABLED=false
# RAG_SUPPORT_GUIDE_SEMANTIC_THRESHOLD=0.6
# 上位の 2 つのガイドの点の差が margin 以下なら、どのガイドに沿うかを確認の問いで確かめる(既定は無効)。
# 全体設定だけで決める(#4784)
# RAG_SUPPORT_GUIDE_CLOSE_MATCH_CLARIFICATION_ENABLED=false
# RAG_SUPPORT_GUIDE_CLOSE_MATCH_MARGIN=1
# 類似問(Approved FAQ)の照合に embedding の意味類似度を加える
RAG_APPROVED_FAQ_SEMANTIC_ENABLED=true
# チャットと RAG 検索で類似問を提示する一致度の下限(0〜1。低いと弱い候補が毎回出る。#684)
RAG_APPROVED_FAQ_SUGGESTION_MIN_SCORE=0.75
RAG_APPROVED_FAQ_SUGGESTION_MAX_GAP=0.1
# 類似問の否定の質問(その FAQ を当てたくない質問の例)に当たったとみなす一致度の下限(0〜1。#4788)。
# 質問と否定の質問の一致度がこの値以上で、FAQ の質問との一致度以上のとき、その FAQ を候補から外す
RAG_APPROVED_FAQ_NEGATIVE_MIN_SCORE=0.75
# 類似問の回答をそのまま返す一致度の下限(0〜1。全体設定だけの値。#4788)。そのまま返すかどうかは、
# 検索・回答プロファイルの類似問の設定(既定はオフ)が持つ。オンのチャットは、補完した質問が
# この値以上で一致したとき、検索と回答の生成を通さずに承認済みの回答を返す(LLM を呼ばない)
RAG_APPROVED_FAQ_DIRECT_ANSWER_MIN_SCORE=0.92

# ===== 質問の準備・会話履歴による質問の書き換え =====
# 既定は有効。チャットの毎回の発話で LLM を 1 回呼び(1 回目の発話も含む)、会話履歴があれば現在の質問を
# 単独で意味が通る形に補い、検索の要らない発話(挨拶・雑談)かを分ける。挨拶・雑談は検索を飛ばして
# 根拠なしの短い応答にする(引用なし。分からないときは検索する)。質問の拡張戦略とは独立した全体設定。
RAG_HISTORY_REWRITE_ENABLED=true

# ===== 質問の準備・検索文 =====
# 登録した用語・同義語による検索文の追加（質問の拡張とは独立。既定 off）
RAG_RUNTIME_TERMS_SEARCH_ENABLED=false
# 回答生成での用語・同義語の補助情報（既定 off）
RAG_RUNTIME_TERMS_ANSWER_ENABLED=false

# ===== 検索・候補の収集と融合 =====
# 検索・チャット・MCP の top_k 省略時の基準件数（1〜100）。DB の取得深度・Rerank 候補総数・引用数とは別。
RAG_SEARCH_TOP_K_DEFAULT=30
RAG_MIN_SIMILARITY=0.20
# 検索方式（ベクトル:全文）と原質問:全追加検索文の順位寄与。件数の配分ではない。
# oracle_hybrid_index（既定）はHybrid Vector Index、oracle_separate_sqlはベクトルとOracle Textの個別SQL。両方式とも共通のSudachi処理で検索語を作る。
RAG_HYBRID_SEARCH_BACKEND=oracle_hybrid_index
# 原生方式のベクトルの分岐で、許可された chunk がこの件数以下なら範囲の行を距離順に読む（0 は常に原生索引）。
# 超えると原生索引で読み、候補の不足は処理の経過とログに残す。根拠は rag/docs/rag-engine.md「ベクトルの分岐の読み方」。
RAG_NATIVE_VECTOR_EXACT_MAX_CHUNKS=50000
# 上の上限を超えて原生索引で読み、範囲に候補があるのに要求より少ないとき、候補をこの倍にして 1 回だけ読み直し、
# 要求の件数に切る（1 は読み直さない。1〜20）。整理までの間、削除の残骸が上位の枠を使う分を埋める（#4097）。
RAG_NATIVE_VECTOR_SHORTAGE_OVERSAMPLE_FACTOR=4
# 原生索引の FULL の整理を始める最小の間隔（時間。0 は間隔なし）。成功・失敗・時間切れを問わず開始から数える。
# 間隔の内は semantic だけを行い、FULL は間隔が過ぎた後に新しい要求が無くても行う。
# 既定の 6 は、FULL の最悪の所要（約 35 分）を 1 CPU の約 1 割に収める値。根拠は rag/docs/native-index-maintenance.md。
RAG_NATIVE_INDEX_FULL_OPTIMIZE_INTERVAL_HOURS=6
# ベクトル:全文。Oracle APIのscore_weightの既定（10:1）より全文の寄与を高めた本システムの既定。全資料に最適との推奨値ではない。
RAG_RRF_METHOD_RATIO=[7,3]
# 原質問:全追加検索文の7:3は独自予算。Oracleの公式既定ではない。
RAG_RRF_SOURCE_RATIO=[7,3]
RAG_RRF_K=60
# 検索文ごとの取得、融合後の基本候補、全拡張を含む精排入力は起点数と独立。
# 0 は追加制限なし（融合候補・再ランキング後の採用上限は独立）。
RAG_RETRIEVAL_QUERY_LIMIT=60
# 選別は rerank の点数で行い、融合順位では費用を抑える上限としてだけ切る。比較は rag/docs/retrieval-budget-evaluation.md。
RAG_RETRIEVAL_CANDIDATE_LIMIT=140
# 明示参照・多様化・各種拡張を含む rerank の入力の合計上限。候補は段ごとの枠の中で先着で入り、
# 融合 → 多様化 → 画面 → 条の目録の順に合計まで採る（既定の 200 は融合 140 + 多様化 20 + 残りの 40 を画面と条の目録で）。
# 0 は有効な各段の上限の合計を使う。
RAG_RERANK_CANDIDATE_LIMIT=200
# rerank の 1 回の要求に載せる候補数（OCI の上限は 1000）。超える候補は分けて送る（点数は変わらない）。
RAG_RERANK_MAX_DOCUMENTS_PER_REQUEST=1000
# 候補の多様化（#2228）: 融合順位の探索深度（0 は無効）と、上位の外から足す件数（新規文書 / 既存文書 / 合計）。
# 基本候補の上限が探索深度以上なら足す候補は無い。
RAG_CANDIDATE_DIVERSITY_DEPTH=420
RAG_CANDIDATE_DIVERSITY_NEW_DOCUMENT=10
RAG_CANDIDATE_DIVERSITY_PRESENT_DOCUMENT=5
RAG_CANDIDATE_DIVERSITY_MAX_EXTRA=20

# ===== 検索・交差参照と実体・文書構造からの候補拡張 =====
# 回答で、上位の候補の chunk が本文で参照する節(「第3章を参照」「別紙1のとおり」など)の chunk を
# rerank の候補に足す(LLM の呼び出しは増えない。参照は取込時に解決する。#1280)
RAG_REFERENCE_EXPANSION_ENABLED=true
# 起点の参照を発見・重複除去した後、新規読取する固有対象数の上限: 1〜120。既読は再利用。
RAG_REFERENCE_EXPANSION_MAX_TARGETS=20
# 交差参照で 1 回の検索に足す固有 chunk 数の上限: 1〜20。依存群を切り分けない。
RAG_REFERENCE_EXPANSION_MAX_CHUNKS=4
# 検索方法の全体設定（名称・別名と章節から根拠を広げる）。画面から保存すると反映する。
# 全体設定だけで決め、検索・回答プロファイルでは上書きしない（#1388・#3053）
RAG_ENTITY_EXPANSION_ENABLED=false
RAG_ENTITY_EXPANSION_MAX_CHUNKS=6
# 関係情報の構築で作った章節・表の見出しの entity と chunk の対応から、回答の検索の候補を足す
# (上位の chunk と同じ狭い章節・表の chunk と、質問に見出しの語が含まれる章節の chunk。LLM は呼ばない。
# 既定 OFF。全体設定だけで決め、検索・回答プロファイルでは上書きしない。#2055)
RAG_GRAPH_EXPANSION_ENABLED=false
# 関係情報で足す chunk 数の上限: 1〜20(全体設定だけで決め、検索・回答プロファイルでは上書きしない)
RAG_GRAPH_EXPANSION_MAX_CHUNKS=6

# 回答で検索候補を rerank で並べ替える(全体設定だけで決め、検索・回答プロファイルでは上書きしない)
RAG_RERANK_ENABLED=true
# 再ランキングで採用する関連度スコアの下限（0〜1。未採点・無効・失敗時は従来の降級）。
RAG_RERANK_MIN_RELEVANCE_SCORE=0.30
# 下限を通った候補を、rerank の順（MMR で似た内容を後ろへ）と検索の順から [前者の件数, 後者の件数] ずつ交互に並べる。
# rerank が無効・失敗のときは使わない。全体設定だけで決め、検索・回答プロファイルでは上書きしない。
RAG_RERANK_SLOT_RATIO=[7,3]
# 成功した再ランキング後の普通候補の採用上限。0=追加制限なし。明示添付・条目録と参照先は別枠で保持。
RAG_RERANK_TOP_N=60

# ===== 根拠の整理・近傍と章節の拡張 =====
# 回答で根拠の前後から足す近傍 child 数: 0〜20(全体設定だけで決め、検索・回答プロファイルでは上書きしない)
RAG_NEIGHBOR_CHILD_COUNT=3
RAG_SECTION_EXPANSION_ENABLED=true
RAG_SECTION_EXPANSION_MAX_LEVELS=4
RAG_SECTION_EXPANSION_INPUT_TOKEN_PERCENT=50
# 業務ガイドの手順ごとの検索が後に来る回答で、最初の章節の拡張が使わずに残す入力の割合
# (章節の拡張の根拠の入力の上限に対する %。0〜50。#2816)
RAG_SECTION_EXPANSION_FOLLOWUP_RESERVE_PERCENT=20

# ===== 根拠の整理・追加検索の共有予算と手順の検索 =====
# 主の検索の後に足す検索(手順ごとの検索・全文検索の語数上限を超えた質問の要求別の補完)の回数の合計の枠。
# 種類ごとの上限はこの枠の中で数える(#2395)
RAG_EXTRA_RETRIEVAL_MAX_QUERIES=8
# 全文検索の語数上限を超えた質問の要求別の補完の、検索の回数・足す根拠(親 chunk)の数・期限(秒)の上限
RAG_REQUEST_COVERAGE_MAX_QUERIES=2
RAG_REQUEST_COVERAGE_MAX_CHUNKS=4
RAG_REQUEST_COVERAGE_DEADLINE_SECONDS=10
# 丸数字・(1) などで並べた小問のうち、根拠が無いか一部だけの小問ごとに検索する小問の数(1 小問 1 回。0 でしない)と、
# 小問ごとに確保する根拠(親 chunk)の数(#2399。期限は上の再検索と共通)
RAG_REQUEST_COVERAGE_MAX_SUBQUESTIONS=5
RAG_REQUEST_COVERAGE_CHUNKS_PER_SUBQUESTION=2
# 業務ガイドの手順(分岐で残った手順)ごとに「質問 + 手順の検索の手がかり」で検索し、手順が参照する
# 資料の頁の根拠を回答の材料に入れる(LLM は呼ばない。全体設定だけで決め、検索・回答プロファイルでは上書きしない。#2395)
RAG_GUIDE_STEP_RETRIEVAL_ENABLED=true
# 必須参照の取得枠を追加検索の合計枠から先に確保する。以下の回数はその後の補助検索・任意手順だけの上限。
# 0 でも必須参照は取得する。機能全体を止める場合は上の ENABLED=false にする。
RAG_GUIDE_STEP_MAX_QUERIES=4
RAG_GUIDE_STEP_CHUNKS_PER_STEP=2
# 必須対象ごとの最低1件に加えて採用する参照候補の上限。本文全体の予算は増やさない。
RAG_GUIDE_REFERENCE_MAX_CHUNKS=4
RAG_GUIDE_STEP_DEADLINE_SECONDS=60

# ===== 回答生成 =====
# LLM を呼ぶ回答生成（チャット・RAG 検索の回答・品質評価の 1 ケース）の通しの上限（秒。上限 600。#375 / #383）。
RAG_ANSWER_TIMEOUT_SECONDS=600
# 回答の生成に渡す根拠の原文の文字予算（文字。1000〜500000。既定 40000。#3776）。根拠の本文・前置き・出典情報・描画の書式を
# この予算で選ぶ（全体設定だけで決め、検索・回答プロファイル・KB・文書レシピでは上書きしない）。
# 章節の拡張で読む量は上の RAG_SECTION_EXPANSION_INPUT_TOKEN_PERCENT（入力 token の上限）で別に数え、
# 生成時はこの文字上限と、指示・schema・出力予約を含むモデルの入力予算の両方に収める。診断に見積もりを残す
RAG_EVIDENCE_BUDGET_CHARS=40000
# 回答は選んだ回答モデル(検索・回答プロファイル・チャットの比較の列・既定のテキストモデル)だけで作る。
# そのモデルが画像対応(モデル設定の「画像入力に対応」)なら根拠の図も添付し、そうでなければ取り込み時の
# 図の説明(文字)で答える。設定の項目は無い(#3444。旧 RAG_ANSWER_VISION_ENABLED は読まない)。
# ===== 品質評価 =====
# 品質評価の job（golden set の評価）の全体の時間の上限の最小値（秒。60〜86400。#390）。
# job の上限は「回答の回数（ケース × 往復）× RAG_ANSWER_TIMEOUT_SECONDS」と
# この値の大きいほうで、86400 秒を超えない（#1430。20 問なら 20 × 600 = 12000 秒）。
# 上限に達したら、残りのケースは実行せずに失敗として記録して結果を返す。
RAG_EVALUATION_JOB_TIMEOUT_SECONDS=3600
# 品質評価で同時に実行するケースの数の上限(#2004。既定 2、1〜8)。1 ケースの往復と判定は順に行い、結果はケースの順のまま。
# 回答・判定が 429 で失敗したら評価の全体で待って並行の数を下げ(最小 1)、送り直す。1 は 1 件ずつ。
RAG_EVALUATION_CONCURRENCY=2

# ===== 旧版の保持 =====
# 切替で退役した版（chunk_set）の保持(#4168)。既定は直前の 1 版を 7 日。
# 保持の間は切替の前に検索された根拠を開ける（検索・回答・件数には出ない）。超えた版は取込ワーカーの清掃が消す。
# 日数の 0 は次の清掃で消す。版の数を超えた古い版は日数に関わらず消す。実行中の job のレシピは待つ。
RAG_CHUNK_SET_RETENTION_DAYS=7
RAG_CHUNK_SET_RETAINED_VERSIONS=1

# ===== 回答の記録の保存 =====
# 回答の記録: 回答の記録（質問・回答・根拠・実行記録）とチャット・RAG 検索の実行履歴の保存期間(日)。
# 0 は無期限で自動では削除しない(既定。#3235)。画面では保存期間を変更しない
RAG_ANSWER_RECORD_RETENTION_DAYS=0
# ===== 業務ガイドの公開履歴と下書きの取込み =====
# 業務ガイドの公開の履歴に残す版の数(#2356。既定 5、1〜100)。公開・前の版に戻すときに、公開日時の新しい順に超えた版を消す。
# 公開中の版は残し、版の番号は振り直さない
# RAG_SUPPORT_GUIDE_MAX_PUBLISHED_REVISIONS=5
# 回答の過程の表(Excel・テキスト)から業務ガイドの下書きを作る(#2397)。1 行で OCI Enterprise AI を 1 回呼ぶ。
# 同時に送る数の上限と、1 回で下書きにする行の数の上限。節の見出しの語は言語資源(guide_import_cues)
# RAG_SUPPORT_GUIDE_IMPORT_CONCURRENCY=4
# RAG_SUPPORT_GUIDE_IMPORT_MAX_ROWS=30

# ===== 安全チェック（入力・出力） =====
RAG_GUARDRAILS_INPUT_ENABLED=false
RAG_GUARDRAILS_OUTPUT_ENABLED=false

# ===== 監査ログ・監視・Trace export =====
# tenant/user id header を監査ログへ hash 化するときの任意 salt。Production では OCI Vault から注入する。
RAG_AUDIT_CONTEXT_HASH_SALT=

# OpenTelemetry / Langfuse 連携用 gateway へ脱機密化済み trace span event を非同期 POST する。
# 空なら構造化ログ + Prometheus のみ。
RAG_TRACE_EXPORT_HTTP_ENDPOINT=
RAG_TRACE_EXPORT_HTTP_BEARER_TOKEN=
RAG_TRACE_EXPORT_HTTP_TIMEOUT_SECONDS=2
RAG_TRACE_EXPORT_QUEUE_SIZE=1024
