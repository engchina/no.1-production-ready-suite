server {
  listen 3000;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # アップロードの上限。nginx の既定（1m）のままだと 1 MB を超える文書を送れない（#280）。
  # backend の RAG_MAX_UPLOAD_BYTES（既定 200 MiB）より少し大きくする（init_script.sh と同じ値）。
  client_max_body_size 210M;
  proxy_connect_timeout 60s;
  proxy_send_timeout 600s;
  proxy_read_timeout 600s;

  location /api/ {
    proxy_pass ${BACKEND_URL}/api/;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
